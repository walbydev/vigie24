# VIGIE24 - ENVIRONNEMENT PRODUCTION (VPS)
# ⚠️ NE PAS COMMITER LES CLES API ⚠️
# Copiez ce fichier en .env.production.local et remplissez vos valeurs
AI_PROVIDER=infomaniak
INFOMANIAK_API_KEY=votre_cle_infomaniak_production
DEEPSEEK_API_KEY=votre_cle_deepseek_production
INFOMANIAK_API_URL=https://api.infomaniak.com
DEEPSEEK_API_URL=https://api.deepseek.com
AI_MODEL=Qwen/Qwen3.5-122B-A10B-FP8
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vigie24_prod
DB_USER=postgres_prod
DB_PASSWORD=votre_mot_de_passe_securise
FEED_POLLING_INTERVAL_MINUTES=15
FEED_MAX_CONCURRENT_REQUESTS=5
FEED_USER_AGENT=Vigie24/1.0 (Production)
SCORING_RECENCY_WEIGHT=0.4
SCORING_RELEVANCE_WEIGHT=0.3
SCORING_SOURCE_WEIGHT=0.2
SCORING_ENGAGEMENT_WEIGHT=0.1
SCORING_MAX_RECENCY_HOURS=72
SCORING_MIN_RELEVANCE_SCORE=0.5
ASPNETCORE_ENVIRONMENT=Production
