@* Share panel for a reading page (/articles/{id}).
   Fully server-rendered on purpose: the panel, the network links and the QR code work
   even when the Blazor circuit is down. Opening, closing, copy-to-clipboard and the
   native share sheet are handled by vigie24.js (delegated listeners), so the native
   share call stays inside the user gesture — on iOS, a server round-trip would lose it. *@
@{
    var title = Title ?? "Article Vigie24";
    var text = BuildText();
    var encodedUrl = Uri.EscapeDataString(Url);
    var encodedTitle = Uri.EscapeDataString(title);
    var encodedText = Uri.EscapeDataString(text);
    var encodedMail = Uri.EscapeDataString($"{text}\n\n{Url}");
    var encodedAll = Uri.EscapeDataString($"{text} {Url}");

    var apps = new (string Label, string Href, string Path)[]
    {
        ("Email", $"mailto:?subject={encodedTitle}&body={encodedMail}", MailPath),
        ("WhatsApp", $"https://wa.me/?text={encodedAll}", WhatsAppPath),
        ("Telegram", $"https://t.me/share/url?url={encodedUrl}&text={encodedText}", TelegramPath),
        ("LinkedIn", $"https://www.linkedin.com/sharing/share-offsite/?url={encodedUrl}", LinkedInPath),
        ("X", $"https://x.com/intent/post?text={encodedTitle}&url={encodedUrl}", XPath)
    };
}

<div class="share" data-share-root>
    <button type="button" class="chip share-btn" data-share-open
            aria-haspopup="dialog" aria-expanded="false" aria-controls="share-panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
        </svg>
        Partager
    </button>

    <div class="share-backdrop" data-share-close hidden></div>

    <div class="share-panel" id="share-panel" role="dialog" aria-modal="false"
         aria-labelledby="share-panel-title" tabindex="-1" hidden
         data-share-url="@Url" data-share-title="@title" data-share-text="@text">
        <div class="share-head">
            <p class="share-title" id="share-panel-title">Partager cet article</p>
            <button type="button" class="share-close" data-share-close aria-label="Fermer le panneau de partage">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
            </button>
        </div>

        <div class="share-copy">
            <input class="share-url" type="text" readonly value="@Url" aria-label="Lien de l'article"
                   data-share-input />
            <button type="button" class="share-copy-btn" data-share-copy>Copier le lien</button>
        </div>
        <p class="share-status" role="status" aria-live="polite" data-share-status></p>

        <div class="share-apps" role="group" aria-label="Envoyer vers">
            @foreach (var app in apps)
            {
                <a class="share-app" href="@app.Href" target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="@app.Path"></path></svg>
                    <span>@app.Label</span>
                </a>
            }
        </div>

        <div class="share-qr">
            <img src="/api/share/qr.svg?url=@encodedUrl" width="104" height="104" loading="lazy"
                 alt="QR code ouvrant cet article sur un téléphone" />
            <p>Scannez ce code pour ouvrir l'article sur votre téléphone.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(SourceUrl))
        {
            <a class="share-source" href="@SourceUrl" target="_blank" rel="noopener noreferrer">
                Lire l'article d'origine@(string.IsNullOrWhiteSpace(SourceName) ? "" : $" ({SourceName})")
            </a>
        }
    </div>

    @* Mobile : bouton flottant empilé au-dessus des flèches haut/bas, dans le même
       conteneur pour que le panneau et lui partagent le même état. *@
    <button type="button" class="share-fab" data-share-open data-share-fab
            aria-label="Partager cet article" aria-haspopup="dialog" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
        </svg>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Summary { get; set; }
    [Parameter] public string? SourceUrl { get; set; }
    [Parameter] public string? SourceName { get; set; }

    // Share text: one-line summary excerpt + attribution. Kept short so it fits a message
    // without being truncated by the target app.
    private string BuildText()
    {
        var raw = string.IsNullOrWhiteSpace(Summary) ? Title : Summary!;
        raw = raw.Replace('\r', ' ').Replace('\n', ' ').Trim();
        if (raw.Length > 140)
        {
            // Coupe sur un mot : une ellipse au milieu d'un mot se lit mal dans un message.
            var cut = raw.LastIndexOf(' ', 140);
            raw = raw[..(cut > 100 ? cut : 140)].TrimEnd(' ', ',', ';', ':') + "…";
        }
        return $"{raw} — Vigie24";
    }

    // Brand marks (Simple Icons, CC0) — inlined: no CDN, no third-party request.
