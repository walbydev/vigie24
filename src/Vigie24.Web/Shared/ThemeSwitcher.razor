@using Microsoft.JSInterop
@inject IJSRuntime JS

@* Sélecteur de thème : clair / sombre × contraste normal / élevé.
   L'attribut data-theme est posé sur <html> par le script anti-flash (localStorage
   ou préférence système) ; ce composant lit et change la préférence. *@
<span class="theme-switcher">
    <select @bind="Theme" @bind:after="ApplyTheme" aria-label="Thème du site : couleurs et contraste">
        <option value="light">☀️ Clair</option>
        <option value="dark">🌙 Sombre</option>
        <option value="light-hc">☀️ Clair haut contraste</option>
        <option value="dark-hc">🌙 Sombre haut contraste</option>
    </select>
</span>

@code {
    private string Theme { get; set; } = "light";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var current = await JS.InvokeAsync<string>("vigie24Theme.get");
            if (!string.IsNullOrEmpty(current)) Theme = current;
            StateHasChanged();
        }
        catch
        {
            // JS unavailable (prerender): keep the default theme
        }
    }

    private async Task ApplyTheme()
    {
        try
        {
            await JS.InvokeVoidAsync("vigie24Theme.set", Theme);
        }
        catch
        {
            // silently: the theme will be applied on the next load
        }
    }
}
