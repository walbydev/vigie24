@using System.Linq.Expressions
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Vigie24.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Vigie24DbContext> DbFactory
@inject IEngagementService Engagement
@inject ILogger<ArticleBrowser> Logger

@* Navigation d'articles : recherche plein-texte, pays, tri, plage de dates, pagination.
   Filtres avancés (sources, score min, note min) dans un panneau dépliable.
   Les requêtes sont exécutées en base (EF Core) sur un contexte dédié. *@

<div class="browser-toolbar">
    <input type="search" class="search-input"
           placeholder="🔍 Rechercher : titre, résumé, source, thème…"
           aria-label="Rechercher dans les articles"
           value="@SearchText" @oninput="OnSearchInput" />
    <select @bind="_country" @bind:after="OnCountryChanged" aria-label="Filtrer par pays d'origine">
        <option value="">🌍 Tous les pays</option>
        @foreach (var c in _availableCountries)
        {
            <option value="@c">@CountryInfo.Display(c)</option>
        }
    </select>
    <select @bind="SortField" @bind:after="OnFilterChanged" aria-label="Trier les articles">
        <option value="date">Tri : plus récents</option>
        <option value="dateAsc">Tri : plus anciens</option>
        <option value="score">Tri : score de classement</option>
        <option value="rating">Tri : note moyenne</option>
        <option value="clicks">Tri : clics</option>
    </select>
    <select @bind="PageSize" @bind:after="OnFilterChanged" aria-label="Nombre d'articles par page">
        <option value="20">20 / page</option>
        <option value="50">50 / page</option>
        <option value="100">100 / page</option>
    </select>
    <button class="btn-toggle @(_advancedOpen ? "open" : "")" @onclick="ToggleAdvanced"
            aria-expanded="@_advancedOpen" aria-controls="advanced-filters">
        @(_advancedOpen ? "▲ Filtres avancés" : "▼ Filtres avancés")
    </button>
    <span class="result-count" role="status" aria-live="polite">
        @if (_totalCount == 0)
        {
            <text>0 article</text>
        }
        else
        {
            var first = (_page - 1) * PageSize + 1;
            var last = Math.Min(_page * PageSize, _totalCount);
            <text>@first–@last sur @_totalCount</text>
        }
    </span>
</div>

@if (_advancedOpen)
{
    <div id="advanced-filters" class="advanced-filters">
        <div class="af-group">
            <label id="lbl-sources">Sources</label>
            <div class="af-chips" role="group" aria-labelledby="lbl-sources">
                @foreach (var s in _availableSources)
                {
                    <button class="af-chip @(_selectedSources.Contains(s) ? "active" : "")"
                            @onclick="() => ToggleSourceAsync(s)"
                            aria-pressed="@(_selectedSources.Contains(s))">@s</button>
                }
            </div>
        </div>
        <div class="af-group">
            <label for="min-score">Score minimum : <span class="af-value">@(_minScore > 0 ? _minScore.ToString() : "—")</span></label>
            <div class="af-range">
                <input id="min-score" type="range" min="0" max="100" step="5" @bind="_minScore" @bind:after="OnFilterChanged" />
                <span class="muted">0 = aucun filtre</span>
            </div>
        </div>
        <div class="af-group">
            <label id="lbl-rating">Note moyenne minimum</label>
            <div class="af-chips" role="group" aria-labelledby="lbl-rating">
                @foreach (var r in new[] { 0, 1, 2, 3, 4, 5 })
                {
                    <button class="af-chip @(_minRating == r ? "active" : "")"
                            @onclick="() => SetMinRatingAsync(r)"
                            aria-pressed="@(_minRating == r)">@(r == 0 ? "Toutes" : "⭐ " + r)</button>
                }
            </div>
        </div>
        <button class="af-reset" @onclick="ResetFiltersAsync">✕ Réinitialiser les filtres</button>
    </div>
}

<TimelineFilter Dates="@_dates" Range="@_range" RangeChanged="@OnRangeChanged" />

@if (!_articles.Any())
{
    <div class="alert alert-warning" role="alert">Aucun article ne correspond à ces critères. Modifiez la recherche ou les filtres.</div>
}
else
{
    <div class="article-grid">
        @foreach (var article in _articles)
        {
            <ArticleCard Article="@article" MyVote="@(_myVotes.TryGetValue(article.Id, out var myVote) ? myVote : (int?)null)" />
        }
    </div>

    <nav class="pagination" aria-label="Pagination">
        <button disabled="@(_page <= 1)" @onclick="() => GoToPageAsync(_page - 1)" aria-label="Page précédente">‹ Précédent</button>
        <span class="page-info">Page <span class="page-current">@_page</span> / @_totalPages</span>
        <button disabled="@(_page >= _totalPages)" @onclick="() => GoToPageAsync(_page + 1)" aria-label="Page suivante">Suivant ›</button>
    </nav>
}

@code {
    /// <summary>
    /// Prédicat de base fourni par la page (articles publiés, catégorie, thème).
    /// ArticleBrowser exécute ses requêtes sur son propre DbContext (factory) pour
    /// ne jamais entrer en concurrence avec le contexte scoped de la page parente.
    /// </summary>
    [Parameter]
    public Func<Expression<Func<Article, bool>>> Filter { get; set; } = null!;

    private List<Article> _articles = new();
    private List<DateTime> _dates = new();
    private Dictionary<Guid, int> _myVotes = new();
    private List<string> _availableCountries = new();
    private List<string> _availableSources = new();
    private int _totalCount;
    private int _totalPages = 1;
    private int _page = 1;
    private string SearchText = "";
    private string SortField = "date";
    private int PageSize = 20;
    private (DateTime? From, DateTime? To)? _range;

    // Filtres
    private bool _advancedOpen;
    private string _country = "";                       // "" = tous les pays
    private readonly HashSet<string> _selectedSources = new();
    private int _minScore;                              // 0 = aucun filtre
    private int _minRating;                             // 0 = aucune note minimale

    private CancellationTokenSource? _searchCts;
    private int _loadVersion;
    private readonly SemaphoreSlim _loadLock = new(1, 1);
    private bool _initialized;
    private Func<Expression<Func<Article, bool>>>? _lastFilter;

    protected override async Task OnInitializedAsync()
    {
        _initialized = true;
        _lastFilter = Filter; // le premier jeu de paramètres est traité ici
        await LoadContextAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Recharge uniquement si le filtre (catégorie / thème) change réellement
        // (le premier jeu de paramètres est couvert par OnInitializedAsync).
        if (!_initialized) return;
        if (!ReferenceEquals(Filter, _lastFilter))
        {
            _lastFilter = Filter;
            _page = 1;
            await LoadContextAsync();
            await LoadAsync();
        }
    }

    /// <summary>Listes des pays et sources disponibles pour le contexte (catégorie / thème) courant</summary>
    private async Task LoadContextAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var filter = Filter();

            _availableCountries = await db.Articles.AsNoTracking().Where(filter)
                .SelectMany(a => a.Sources)
                .Where(s => s.Source.CountryCode != null)
                .Select(s => s.Source.CountryCode!)
                .Distinct()
                .OrderBy(c => c)
                .ToListAsync();

            _availableSources = await db.Articles.AsNoTracking().Where(filter)
                .SelectMany(a => a.Sources)
                .Select(s => s.Source.Name)
                .Distinct()
                .OrderBy(n => n)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Impossible de charger les pays/sources disponibles");
        }
    }

    private IQueryable<Article> ApplyFilters(IQueryable<Article> q)
    {
        var search = SearchText?.Trim();
        if (!string.IsNullOrEmpty(search))
        {
            var pattern = $"%{search}%";
            q = q.Where(a => EF.Functions.ILike(a.Title, pattern)
                || EF.Functions.ILike(a.Summary, pattern)
                || a.Tags.Any(t => EF.Functions.ILike(t.Tag.Slug, pattern))
                || a.Sources.Any(s => EF.Functions.ILike(s.Source.Name, pattern)));
        }

        if (!string.IsNullOrEmpty(_country))
        {
            // Le pays affiché est celui de la source primaire
            q = q.Where(a => a.Sources.Any(s => s.IsPrimary && s.Source.CountryCode == _country));
        }

        if (_selectedSources.Count > 0)
        {
            q = q.Where(a => a.Sources.Any(s => _selectedSources.Contains(s.Source.Name)));
        }

        if (_minScore > 0)
        {
            q = q.Where(a => a.RankingScore >= _minScore);
        }

        if (_minRating > 0)
        {
            q = q.Where(a => a.VoteAverage >= _minRating);
        }

        if (_range is { } range)
        {
            if (range.From.HasValue) q = q.Where(a => a.PublishedAt >= range.From.Value);
            if (range.To.HasValue) q = q.Where(a => a.PublishedAt < range.To.Value);
        }

        return q;
    }

    private static IQueryable<Article> ApplySort(IQueryable<Article> q, string sortField) => sortField switch
    {
        "dateAsc" => q.OrderBy(a => a.PublishedAt).ThenBy(a => a.Id),
        "score" => q.OrderByDescending(a => a.RankingScore).ThenByDescending(a => a.PublishedAt).ThenBy(a => a.Id),
        "rating" => q.OrderByDescending(a => a.VoteAverage).ThenByDescending(a => a.PublishedAt).ThenBy(a => a.Id),
        "clicks" => q.OrderByDescending(a => a.ClickCount).ThenByDescending(a => a.PublishedAt).ThenBy(a => a.Id),
        _ => q.OrderByDescending(a => a.PublishedAt).ThenBy(a => a.Id)
    };

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        // Debounce 400 ms pour ne pas marteler la base à chaque frappe
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var cts = _searchCts;
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        _page = 1;
        await LoadAsync();
    }

    private async Task OnFilterChanged()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnCountryChanged()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task OnRangeChanged((DateTime? From, DateTime? To)? range)
    {
        _range = range;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _page = page;
        await LoadAsync();
    }

    private Task ToggleAdvanced()
    {
        _advancedOpen = !_advancedOpen;
        return Task.CompletedTask;
    }

    private async Task ToggleSourceAsync(string name)
    {
        if (!_selectedSources.Add(name)) _selectedSources.Remove(name);
        _page = 1;
        await LoadAsync();
    }

    private async Task SetMinRatingAsync(int rating)
    {
        _minRating = rating == _minRating ? 0 : rating;
        _page = 1;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _searchCts?.Cancel();
        SearchText = "";
        _country = "";
        _selectedSources.Clear();
        _minScore = 0;
        _minRating = 0;
        _range = null;
        _page = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Sémaphore : un seul chargement à la fois sur le DbContext dédié,
        // même pendant le prerender où les continuations s'exécutent sur le pool.
        await _loadLock.WaitAsync();
        var version = ++_loadVersion;
        try
        {
            // Contexte dédié : aucune concurrence avec le DbContext scoped de la page.
            await using var db = await DbFactory.CreateDbContextAsync();

            var filtered = ApplyFilters(db.Articles.Where(Filter()));

            var totalCount = await filtered.CountAsync();
            var dates = await filtered.Select(a => a.PublishedAt).ToListAsync();

            if (version != _loadVersion) return; // une requête plus récente a pris la main

            _totalCount = totalCount;
            _totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
            if (_page > _totalPages) _page = _totalPages;

            _dates = dates;

            var pageQuery = ApplySort(ApplyFilters(db.Articles.Where(Filter())), SortField)
                .Skip((_page - 1) * PageSize)
                .Take(PageSize)
                .Include(a => a.Category).ThenInclude(c => c!.ParentCategory)
                .Include(a => a.Authors).ThenInclude(a => a.Author)
                .Include(a => a.Sources).ThenInclude(s => s.Source)
                .Include(a => a.Tags).ThenInclude(t => t.Tag);

            var articles = await pageQuery.ToListAsync();
            if (version != _loadVersion) return;

            // Votes du visiteur pour la page affichée (une seule requête groupée)
            var myVotes = await Engagement.GetMyVotesAsync(articles.Select(a => a.Id).ToList());
            if (version != _loadVersion) return;

            _articles = articles;
            _myVotes = myVotes;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Échec du chargement des articles du navigateur");
            if (version != _loadVersion) return;
            _articles = new();
            _totalCount = 0;
            _totalPages = 1;
        }
        finally
        {
            _loadLock.Release();
            StateHasChanged();
        }
    }
}
