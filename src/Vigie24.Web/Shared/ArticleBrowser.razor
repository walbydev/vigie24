@using System.Linq.Expressions
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Vigie24.Infrastructure.Queries
@using Vigie24.Web.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.JSInterop
@inject IDbContextFactory<Vigie24DbContext> DbFactory
@inject IEngagementService Engagement
@inject NavigationManager Nav
@inject ProtectedLocalStorage Storage
@inject IJSRuntime JS
@inject ILogger<ArticleBrowser> Logger

@* Navigation d'articles : recherche plein-texte, pays, tri, plage de dates, pagination.
   Filtres avancés (sources, score min, note min) dans un panneau dépliable.
   Les requêtes sont exécutées en base (EF Core) sur un contexte dédié. *@

<div class="browser-toolbar">
    <input type="search" class="search-input"
           placeholder="🔍 Rechercher : titre, résumé, source, thème…"
           aria-label="Rechercher dans les articles"
           value="@SearchText" @oninput="OnSearchInput" />
    <select @bind="_country" @bind:after="OnCountryChanged" aria-label="Filtrer par pays d'origine">
        <option value="">🌍 Tous les pays</option>
        @foreach (var c in _availableCountries)
        {
            <option value="@c">@CountryInfo.Display(c)</option>
        }
    </select>
    <select @bind="SortField" @bind:after="OnFilterChanged" aria-label="Trier les articles">
        <option value="date">Tri : plus récents</option>
        <option value="dateAsc">Tri : plus anciens</option>
        <option value="score">Tri : score de classement</option>
        <option value="rating">Tri : note moyenne</option>
        <option value="clicks">Tri : clics</option>
    </select>
    <select @bind="_sourceKind" @bind:after="OnFilterChanged" aria-label="Type de source">
        <option value="">Type : tous</option>
        <option value="youtube">📺 YouTube</option>
        <option value="reddit">💬 Reddit</option>
        <option value="press">Presse</option>
        <option value="bloglab">Blogs</option>
    </select>
    <select @bind="PageSize" @bind:after="OnFilterChanged" aria-label="Nombre d'articles par page">
        <option value="20">20 / page</option>
        <option value="50">50 / page</option>
        <option value="100">100 / page</option>
    </select>
    <button class="btn-toggle @(_advancedOpen ? "open" : "")" @onclick="ToggleAdvanced"
            aria-expanded="@_advancedOpen" aria-controls="advanced-filters">
        @(_advancedOpen ? "▲ Filtres avancés" : "▼ Filtres avancés")
    </button>
    <span class="result-count" role="status" aria-live="polite">
        @if (_totalCount == 0)
        {
            <text>0 article</text>
        }
        else
        {
            var first = (_page - 1) * PageSize + 1;
            var last = Math.Min(_page * PageSize, _totalCount);
            <text>@first–@last&nbsp;sur&nbsp;@_totalCount</text>
        }
    </span>
</div>

@if (_advancedOpen)
{
    <div id="advanced-filters" class="advanced-filters">
        <div class="af-group">
            <label id="lbl-sources">Sources</label>
            <div class="af-chips" role="group" aria-labelledby="lbl-sources">
                @foreach (var s in _availableSources)
                {
                    <button class="af-chip @(_selectedSources.Contains(s) ? "active" : "")"
                            @onclick="() => ToggleSourceAsync(s)"
                            aria-pressed="@(_selectedSources.Contains(s))">@s</button>
                }
            </div>
        </div>
        <div class="af-group">
            <label for="min-score">Score minimum : <span class="af-value">@(_minScore > 0 ? _minScore.ToString() : "—")</span></label>
            <div class="af-range">
                <input id="min-score" type="range" min="0" max="100" step="5" @bind="_minScore" @bind:after="OnFilterChanged" />
                <span class="muted">0 = aucun filtre</span>
            </div>
        </div>
        <div class="af-group">
            <label for="max-anxiety">Anxiété max : <span class="af-value">@(_maxAnxiety < 10 ? _maxAnxiety.ToString() : "—")</span></label>
            <div class="af-range">
                <input id="max-anxiety" type="range" min="0" max="10" step="1" @bind="_maxAnxiety" @bind:after="OnFilterChanged" />
                <span class="muted">10 = aucun filtre · 0 = non anxiogène uniquement</span>
            </div>
        </div>
        <div class="af-group">
            <label id="lbl-rating">Note moyenne minimum</label>
            <div class="af-chips" role="group" aria-labelledby="lbl-rating">
                @foreach (var r in new[] { 0, 1, 2, 3, 4, 5 })
                {
                    <button class="af-chip @(_minRating == r ? "active" : "")"
                            @onclick="() => SetMinRatingAsync(r)"
                            aria-pressed="@(_minRating == r)">@(r == 0 ? "Toutes" : "⭐ " + r)</button>
                }
            </div>
        </div>
        <button class="af-reset" @onclick="ResetFiltersAsync">✕ Réinitialiser les filtres</button>
        <div class="af-group">
            <label id="lbl-prefs">Mes préférences</label>
            <div class="af-actions">
                <button class="af-chip" @onclick="CopyRssLinkAsync" title="Flux RSS reprenant ces filtres, à coller dans votre lecteur">📡 Copier le lien RSS</button>
                <button class="af-chip" @onclick="CopyViewLinkAsync" title="Lien partageable qui ouvre cette vue avec ses filtres">🔗 Copier le lien de cette vue</button>
                @if (!string.IsNullOrEmpty(_copiedMessage))
                {
                    <span class="af-copied muted">@_copiedMessage</span>
                }
            </div>
        </div>
        <div class="af-note muted">✓ Filtres mémorisés sur cet appareil et restaurés à votre prochaine visite</div>
    </div>
}

<TimelineFilter Dates="@_dates" Range="@_range" RangeChanged="@OnRangeChanged" />

@if (!_articles.Any())
{
    <div class="alert alert-warning" role="alert">Aucun article ne correspond à ces critères. Modifiez la recherche ou les filtres.</div>
}
else
{
    <div class="article-grid">
        @foreach (var article in _articles)
        {
            <ArticleCard Article="@article" MyVote="@(_myVotes.TryGetValue(article.Id, out var myVote) ? myVote : (int?)null)" ShowStance="ShowStance" />
        }
    </div>

    <nav class="pagination" aria-label="Pagination">
        <button disabled="@(_page <= 1)" @onclick="() => GoToPageAsync(_page - 1)" aria-label="Page précédente">‹ Précédent</button>
        <span class="page-info">Page <span class="page-current">@_page</span> / @_totalPages</span>
        <button disabled="@(_page >= _totalPages)" @onclick="() => GoToPageAsync(_page + 1)" aria-label="Page suivante">Suivant ›</button>
    </nav>
}

@code {
    /// <summary>
    /// Base predicate provided by the page (published articles, category, theme).
    /// ArticleBrowser runs its queries on its own DbContext (factory) to
    /// ne jamais entrer en concurrence avec le contexte scoped de la page parente.
    /// </summary>
    [Parameter]
    public Func<Expression<Func<Article, bool>>> Filter { get; set; } = null!;

    /// <summary>Chemin du flux RSS de ce contexte (ex. "/feed", "/categories/ia/feed").</summary>
    [Parameter]
    public string RssPath { get; set; } = "/feed";

    /// <summary>Forwards the stance badge display to the cards (debate candidates view).</summary>
    [Parameter]
    public bool ShowStance { get; set; }

    private List<Article> _articles = new();
    private List<DateTime> _dates = new();
    private Dictionary<Guid, int> _myVotes = new();
    private List<string> _availableCountries = new();
    private List<string> _availableSources = new();
    private int _totalCount;
    private int _totalPages = 1;
    private int _page = 1;
    private string SearchText = "";
    private string SortField = "date";
    private int PageSize = 50;
    private (DateTime? From, DateTime? To)? _range;

    // Filtres
    private bool _advancedOpen;
    private string _country = "";                       // "" = tous les pays
    private string _sourceKind = "";                    // "" = tous ; youtube | reddit | press | bloglab
    private readonly HashSet<string> _selectedSources = new();
    private int _minScore;                              // 0 = aucun filtre
    private int _minRating;                             // 0 = aucune note minimale
    private int _maxAnxiety = 10;                       // 10 = aucun filtre ; 0-9 = plafond d'anxiété
    private bool _urlHadFilters;                        // l'URL portait des filtres explicites

    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _saveCts;
    private int _loadVersion;
    private readonly SemaphoreSlim _loadLock = new(1, 1);
    private bool _initialized;
    private Func<Expression<Func<Article, bool>>>? _lastFilter;

    protected override async Task OnInitializedAsync()
    {
        _initialized = true;
        _lastFilter = Filter; // le premier jeu de paramètres est traité ici
        ApplyUrlFilters();    // une URL explicite (?q=…&country=…) prime sur tout
        await LoadContextAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Reload only when the filter (category / theme) actually changes
        // (the first parameter set is covered by OnInitializedAsync).
        if (!_initialized) return;
        if (!ReferenceEquals(Filter, _lastFilter))
        {
            _lastFilter = Filter;
            _page = 1;
            await LoadContextAsync();
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Local restore ONLY after the first interactive render: during
        // prerender, ProtectedLocalStorage est indisponible et le HTML initial doit rester
        // identique client/serveur. Une URL explicite prime sur la sauvegarde.
        if (!firstRender || _urlHadFilters)
            return;
        await RestoreSavedFiltersAsync();
    }

    /// <summary>Restores the last filters remembered on this device (ProtectedLocalStorage).</summary>
    private async Task RestoreSavedFiltersAsync()
    {
        try
        {
            var saved = await Storage.GetAsync<string>("vigie24.filters");
            if (!saved.Success || string.IsNullOrEmpty(saved.Value))
                return;
            var criteria = FilterCriteria.FromJson(saved.Value);
            if (criteria is null || criteria.IsEmpty)
                return;
            ApplyCriteria(criteria);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Impossible de restaurer les filtres sauvegardés localement");
        }
    }

    /// <summary>Schedules a debounced local save (1 s after the last change).</summary>
    private void ScheduleFilterSave()
    {
        _saveCts?.Cancel();
        _saveCts = new CancellationTokenSource();
        _ = SaveFiltersDebouncedAsync(_saveCts.Token);
    }

    private async Task SaveFiltersDebouncedAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(1000, token);
            var criteria = BuildCriteria();
            if (criteria.IsEmpty)
            {
                await Storage.DeleteAsync("vigie24.filters");
                return;
            }
            await Storage.SetAsync("vigie24.filters", criteria.ToJson());
        }
        catch (OperationCanceledException)
        {
            // a more recent change took over
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Impossible de sauvegarder les filtres localement");
        }
    }

    /// <summary>Lists of countries and sources available for the current (category / theme) context</summary>
    private async Task LoadContextAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var filter = Filter();

            _availableCountries = await db.Articles.AsNoTracking().Where(filter)
                .SelectMany(a => a.Sources)
                .Where(s => s.Source.CountryCode != null)
                .Select(s => s.Source.CountryCode!)
                .Distinct()
                .OrderBy(c => c)
                .ToListAsync();

            _availableSources = await db.Articles.AsNoTracking().Where(filter)
                .SelectMany(a => a.Sources)
                .Select(s => s.Source.Name)
                .Distinct()
                .OrderBy(n => n)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Impossible de charger les pays/sources disponibles");
        }
    }

    private IQueryable<Article> ApplyFilters(IQueryable<Article> q)
        => q.ApplyFilterCriteria(BuildCriteria());

    /// <summary>
    /// Current component criteria, single source of truth shared with RSS feeds.
    /// Le tri et la pagination restent propres au composant (le RSS trie par date).
    /// </summary>
    private FilterCriteria BuildCriteria() => new()
    {
        SearchText = SearchText,
        CountryCode = _country,
        SourceKind = _sourceKind,
        SelectedSources = _selectedSources.ToList(),
        MinScore = _minScore,
        MinRating = _minRating,
        MaxAnxiety = _maxAnxiety,
        RangeFrom = _range?.From,
        RangeTo = _range?.To,
        SortField = SortField,
        PageSize = PageSize
    };

    /// <summary>
    /// Applies the filters carried by the URL query string (shared link / bookmark).
    /// A malformed query is ignored (the UI stays tolerant, unlike the RSS which answers 400).
    /// </summary>
    private void ApplyUrlFilters()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (!FilterCriteria.TryParse(uri.Query, out var criteria) || criteria.IsEmpty)
            return;
        ApplyCriteria(criteria);
        _urlHadFilters = true;
    }

    /// <summary>Hydrates the component state from criteria (URL or local save).</summary>
    private void ApplyCriteria(FilterCriteria criteria)
    {
        SearchText = criteria.SearchText ?? "";
        _country = criteria.CountryCode ?? "";
        _sourceKind = criteria.SourceKind ?? "";
        _selectedSources.Clear();
        foreach (var s in criteria.SelectedSources)
            _selectedSources.Add(s);
        _minScore = criteria.MinScore;
        _minRating = criteria.MinRating;
        _maxAnxiety = criteria.MaxAnxiety;
        _range = (criteria.RangeFrom, criteria.RangeTo);
        SortField = criteria.SortField;
        PageSize = criteria.PageSize;
    }

    private static IQueryable<Article> ApplySort(IQueryable<Article> q, string sortField) => sortField switch
    {
        "dateAsc" => q.OrderBy(a => a.PublishedAt).ThenBy(a => a.Id),
        "score" => q.OrderByDescending(a => a.RankingScore).ThenByDescending(a => a.PublishedAt).ThenBy(a => a.Id),
        "rating" => q.OrderByDescending(a => a.VoteAverage).ThenByDescending(a => a.PublishedAt).ThenBy(a => a.Id),
        "clicks" => q.OrderByDescending(a => a.ClickCount).ThenByDescending(a => a.PublishedAt).ThenBy(a => a.Id),
        _ => q.OrderByDescending(a => a.PublishedAt).ThenBy(a => a.Id)
    };

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        // 400 ms debounce to avoid hammering the database on every keystroke
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var cts = _searchCts;
        try
        {
            await Task.Delay(400, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        _page = 1;
        await LoadAsync();
        ScheduleFilterSave();
    }

    private async Task OnFilterChanged()
    {
        _page = 1;
        await LoadAsync();
        ScheduleFilterSave();
    }

    private async Task OnCountryChanged()
    {
        _page = 1;
        await LoadAsync();
        ScheduleFilterSave();
    }

    private async Task OnRangeChanged((DateTime? From, DateTime? To)? range)
    {
        _range = range;
        _page = 1;
        await LoadAsync();
        ScheduleFilterSave();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _page = page;
        await LoadAsync();
    }

    private Task ToggleAdvanced()
    {
        _advancedOpen = !_advancedOpen;
        return Task.CompletedTask;
    }

    private async Task ToggleSourceAsync(string name)
    {
        if (!_selectedSources.Add(name)) _selectedSources.Remove(name);
        _page = 1;
        await LoadAsync();
        ScheduleFilterSave();
    }

    private async Task SetMinRatingAsync(int rating)
    {
        _minRating = rating == _minRating ? 0 : rating;
        _page = 1;
        await LoadAsync();
        ScheduleFilterSave();
    }

    private async Task ResetFiltersAsync()
    {
        _searchCts?.Cancel();
        SearchText = "";
        _country = "";
        _sourceKind = "";
        _selectedSources.Clear();
        _minScore = 0;
        _minRating = 0;
        _maxAnxiety = 10;
        _range = null;
        _page = 1;
        await LoadAsync();
        try
        {
            await Storage.DeleteAsync("vigie24.filters");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Impossible d'effacer les filtres sauvegardés localement");
        }
    }

    private string? _copiedMessage;

    /// <summary>URL du flux RSS reprenant les filtres courants (base + chemin + query).</summary>
    private string RssUrl => Nav.BaseUri.TrimEnd('/') + RssPath + BuildCriteria().ToQueryString();

    /// <summary>URL partageable de la vue courante (chemin + query des filtres).</summary>
    private string ViewUrl => Nav.ToAbsoluteUri(Nav.Uri).GetLeftPart(UriPartial.Path) + BuildCriteria().ToQueryString();

    private async Task CopyRssLinkAsync()
    {
        _copiedMessage = null;
        var ok = await JS.InvokeAsync<bool>("vigie24.copyText", RssUrl);
        _copiedMessage = ok ? "lien RSS copié ✓" : "copie impossible dans ce navigateur";
    }

    private async Task CopyViewLinkAsync()
    {
        _copiedMessage = null;
        var ok = await JS.InvokeAsync<bool>("vigie24.copyText", ViewUrl);
        _copiedMessage = ok ? "lien copié ✓" : "copie impossible dans ce navigateur";
    }

    private async Task LoadAsync()
    {
        // Semaphore: only one load at a time on the dedicated DbContext,
        // even during prerender when continuations run on the pool.
        await _loadLock.WaitAsync();
        var version = ++_loadVersion;
        try
        {
            // Dedicated context: no concurrency with the page's scoped DbContext.
            await using var db = await DbFactory.CreateDbContextAsync();

            var filtered = ApplyFilters(db.Articles.Where(Filter()));

            var totalCount = await filtered.CountAsync();
            var dates = await filtered.Select(a => a.PublishedAt).ToListAsync();

            if (version != _loadVersion) return; // une requête plus récente a pris la main

            _totalCount = totalCount;
            _totalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
            if (_page > _totalPages) _page = _totalPages;

            _dates = dates;

            var pageQuery = ApplySort(ApplyFilters(db.Articles.Where(Filter())), SortField)
                .Skip((_page - 1) * PageSize)
                .Take(PageSize)
                .Include(a => a.Category).ThenInclude(c => c!.ParentCategory)
                .Include(a => a.Authors).ThenInclude(a => a.Author)
                .Include(a => a.Sources).ThenInclude(s => s.Source)
                .Include(a => a.Tags).ThenInclude(t => t.Tag)
                .Include(a => a.DebateArticles);

            var articles = await pageQuery.ToListAsync();
            if (version != _loadVersion) return;

            // Visitor's votes for the displayed page (one batched query)
            var myVotes = await Engagement.GetMyVotesAsync(articles.Select(a => a.Id).ToList());
            if (version != _loadVersion) return;

            _articles = articles;
            _myVotes = myVotes;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Échec du chargement des articles du navigateur");
            if (version != _loadVersion) return;
            _articles = new();
            _totalCount = 0;
            _totalPages = 1;
        }
        finally
        {
            _loadLock.Release();
            StateHasChanged();
        }
    }
}
