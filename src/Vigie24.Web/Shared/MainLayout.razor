@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="page">
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <nav class="topnav" aria-label="Navigation principale">
        <a class="brand" href="/">
            @if (IsRadarBranding)
            {
                <img src="/favicon-radar-32.png" alt="" class="brand-logo" width="34" height="34" />
            }
            <span class="brand-text">Vigie<span>24</span></span>
        </a>
        <button class="nav-toggle" @onclick="ToggleMenu"
                aria-expanded="@_menuOpen" aria-controls="nav-links"
                aria-label="@(_menuOpen ? "Fermer le menu" : "Ouvrir le menu")">
            <span class="bar"></span><span class="bar"></span><span class="bar"></span>
        </button>
        <div class="nav-links @(_menuOpen ? "open" : "")" id="nav-links" @onclick="CloseMenu">
            <NavLink class="nav" href="/" Match="NavLinkMatch.All">Accueil</NavLink>
            <NavLink class="nav" href="/categories">Catégories</NavLink>
            <NavLink class="nav" href="/themes">Thématiques</NavLink>
            <NavLink class="nav" href="/projet">Projet</NavLink>
        </div>
        <div class="topnav-right">
            <FontSizeSwitcher />
            <ThemeSwitcher />
        </div>
    </nav>
    <main id="main-content">
        <div class="content px-4">
            @Body
        </div>
    </main>
    <footer class="site-footer" role="contentinfo">
        <div class="footer-inner">
            <div class="footer-brand">
                <strong>Vigie<span>24</span></strong>
                <p>Surveillance RSS et analyse IA — veille technologique francophone et internationale (France, Suisse, Belgique, Québec, Luxembourg).</p>
            </div>
            <div class="footer-col">
                <h3>Navigation</h3>
                <a href="/">Accueil</a>
                <a href="/categories">Catégories</a>
                <a href="/themes">Thématiques</a>
                <a href="/sources">🗂 Sources</a>
                <a href="/debats">🥊 Débats</a>
                <a href="/debats/candidats">🎯 Candidats débats</a>
                <a href="/feed" rel="alternate" type="application/rss+xml">📡 Flux RSS</a>
            </div>
            <div class="footer-col">
                <h3>Projet</h3>
                <a href="/projet">📖 Le projet</a>
                <a href="/charte-graphique">🎨 Charte graphique</a>
                <a href="/couts">💰 Coûts IA</a>
                <a href="/license">Licence MIT</a>
                <a href="mailto:contact@vigie24.info">✉️ contact@vigie24.info</a>
                <span class="footer-legal">© @DateTime.UtcNow.Year Walby Developments</span>
            </div>
        </div>
        <div class="footer-bottom">
            Vigie24 — logiciel libre sous licence MIT · données issues de flux RSS publics
        </div>
    </footer>
    <div class="scroll-fabs">
        <button type="button" class="scroll-fab" id="fab-top" aria-label="Remonter en haut de page" title="Haut de page">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path d="M12 19V5M5 12l7-7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <button type="button" class="scroll-fab" id="fab-bottom" aria-label="Aller en bas de page" title="Bas de page">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path d="M12 5v14M5 12l7 7 7-7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </div>
</div>

@code {
    private bool _menuOpen;

    private bool IsRadarBranding =>
        string.Equals(Config["Branding:Theme"], "radar", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;
}
