@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="page">
    <a class="skip-link" href="#main-content">Aller au contenu</a>
    <nav class="topnav" aria-label="Navigation principale">
        <a class="brand" href="/">
            @if (IsRadarBranding)
            {
                <img src="/favicon-radar-32.png" alt="" class="brand-logo" width="34" height="34" />
            }
            <span class="brand-text">Vigie<span>24</span></span>
        </a>
        <button class="nav-toggle" @onclick="ToggleMenu"
                aria-expanded="@_menuOpen" aria-controls="nav-links"
                aria-label="@(_menuOpen ? "Fermer le menu" : "Ouvrir le menu")">
            <span class="bar"></span><span class="bar"></span><span class="bar"></span>
        </button>
        <div class="nav-links @(_menuOpen ? "open" : "")" id="nav-links" @onclick="CloseMenu">
            <NavLink class="nav" href="/" Match="NavLinkMatch.All">Accueil</NavLink>
            <NavLink class="nav" href="/briefing">Briefing</NavLink>
            <NavLink class="nav" href="/barometre">Baromètre</NavLink>
            <NavLink class="nav" href="/journal">Journal</NavLink>
            <NavLink class="nav" href="/projet">Projet</NavLink>
        </div>
        <div class="topnav-right">
            <ZenToggle />
            <FontSizeSwitcher />
            <ThemeSwitcher />
        </div>
    </nav>
    <nav class="subnav" aria-label="Navigation par contenu">
        <NavLink class="subnav-link" href="/articles">Articles</NavLink>
        <NavLink class="subnav-link" href="/categories">Catégories</NavLink>
        <NavLink class="subnav-link" href="/themes">Thématiques</NavLink>
        <NavLink class="subnav-link" href="/debats">Débats</NavLink>
        <NavLink class="subnav-link subnav-more-link" href="/radar">Radar</NavLink>
        <NavLink class="subnav-link subnav-more-link" href="/top">Top</NavLink>
        <NavLink class="subnav-link subnav-more-link" href="/sources">Sources</NavLink>
        <NavLink class="subnav-link subnav-more-link" href="/il-y-a-un-an">Il y a un an</NavLink>
        <span class="subnav-spacer"></span>
        <a class="subnav-link subnav-feed subnav-more-link" href="/feed" rel="alternate" type="application/rss+xml" title="Flux RSS complet">RSS</a>
        <a class="subnav-link subnav-feed subnav-more-link" href="/feed/zen" rel="alternate" type="application/rss+xml" title="Flux RSS zen (anxiété ≤ 6)">RSS zen</a>
        <button type="button" class="subnav-more" @onclick="ToggleSubnav"
                aria-expanded="@_subnavOpen" aria-controls="subnav-panel"
                aria-label="Toutes les pages de contenu">
            ⋯ Plus
        </button>
    </nav>
    @if (_subnavOpen)
    {
        <div class="subnav-panel" id="subnav-panel">
            <NavLink class="subnav-panel-link" href="/radar" @onclick="CloseSubnav">Radar des sujets chauds</NavLink>
            <NavLink class="subnav-panel-link" href="/top" @onclick="CloseSubnav">Top de la communauté</NavLink>
            <NavLink class="subnav-panel-link" href="/sources" @onclick="CloseSubnav">Sources</NavLink>
            <NavLink class="subnav-panel-link" href="/il-y-a-un-an" @onclick="CloseSubnav">Il y a un an</NavLink>
            <a class="subnav-panel-link" href="/feed" rel="alternate" type="application/rss+xml" @onclick="CloseSubnav">Flux RSS complet</a>
            <a class="subnav-panel-link" href="/feed/zen" rel="alternate" type="application/rss+xml" @onclick="CloseSubnav">Flux RSS zen (anxiété ≤ 6)</a>
        </div>
    }
    <main id="main-content">
        <div class="content px-4">
            @Body
        </div>
    </main>
    <footer class="site-footer" role="contentinfo">
        <div class="footer-inner">
            <div class="footer-brand">
                <strong>Vigie<span>24</span></strong>
                <p>Surveillance RSS et analyse IA — une veille technologique <strong>francophone</strong> (France, Suisse, Belgique, Québec, Luxembourg), ouverte sur l'actualité internationale.</p>
            </div>
            <div class="footer-col">
                <h3>Navigation</h3>
                <a href="/articles">Articles</a>
                <a href="/categories">Catégories</a>
                <a href="/themes">Thématiques</a>
                <a href="/debats">Débats</a>
                <a href="/debats/candidats">Candidats débats</a>
                <a href="/radar">Radar des sujets chauds</a>
                <a href="/top">Top de la communauté</a>
                <a href="/sources">Sources</a>
                <a href="/il-y-a-un-an">Il y a un an</a>
            </div>
            <div class="footer-col">
                <h3>Veille</h3>
                <a href="/briefing">Briefing du matin</a>
                <a href="/barometre">Baromètre de l'anxiété</a>
                <a href="/journal">Journal du rédacteur IA</a>
                <a href="/feed" rel="alternate" type="application/rss+xml">Flux RSS</a>
                <a href="/feed/zen" rel="alternate" type="application/rss+xml">Flux RSS zen (anxiété ≤ 6)</a>
            </div>
            <div class="footer-col">
                <h3>Projet</h3>
                <a href="/projet">Le projet</a>
                <a href="/charte-graphique">Charte graphique</a>
                <a href="/couts">Coûts IA</a>
                <a href="/license">Licence MIT</a>
                <a href="/confidentialite">Confidentialité</a>
                <a href="/mentions-legales">Mentions légales</a>
                <a href="mailto:contact@vigie24.info">contact@vigie24.info</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.UtcNow.Year Walby Developments</span>
            <span class="footer-bottom-sep" aria-hidden="true">·</span>
            <span>Vigie24 — logiciel libre sous licence MIT</span>
            <span class="footer-bottom-sep" aria-hidden="true">·</span>
            <span>Données issues de flux RSS publics</span>
        </div>
    </footer>
    <div class="scroll-fabs" role="group" aria-label="Défilement de la page">
        <button type="button" class="scroll-fab" id="fab-top" aria-label="Remonter en haut de page" title="Haut de page">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <div class="scroll-track" aria-hidden="true">
            <div class="scroll-thumb"></div>
        </div>
        <button type="button" class="scroll-fab" id="fab-bottom" aria-label="Aller en bas de page" title="Bas de page">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </div>
</div>

@code {
    private bool _menuOpen;
    private bool _subnavOpen;

    private bool IsRadarBranding =>
        string.Equals(Config["Branding:Theme"], "radar", StringComparison.OrdinalIgnoreCase);

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    /// <summary>Mobile : ouvre/ferme le panneau « ⋯ Plus » de la barre secondaire.</summary>
    private void ToggleSubnav() => _subnavOpen = !_subnavOpen;

    private void CloseSubnav() => _subnavOpen = false;

    private void CloseMenu() => _menuOpen = false;
}
