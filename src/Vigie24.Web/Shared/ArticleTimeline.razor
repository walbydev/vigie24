@inject IJSRuntime JS
@using Vigie24.Domain
@using Microsoft.JSInterop

@if (TotalPages > 1)
{
    <div class="article-timeline" id="article-timeline">
        <div class="tl-track" id="tl-track">
            @foreach (var tick in _ticks)
            {
                <div class="tl-tick" style="top: @TickPercent(tick)%" title="@tick.Label"></div>
            }
            <div class="tl-thumb" id="tl-thumb"
                 role="slider" tabindex="0"
                 aria-label="Naviguer dans les articles"
                 aria-valuemin="1" aria-valuemax="@TotalPages" aria-valuenow="@CurrentPage"
                 style="top: @_thumbTop.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%; height: @_thumbHeight.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                <span class="tl-thumb-knob"></span>
            </div>
        </div>
        <div class="tl-tooltip" id="tl-tooltip" role="status" aria-live="polite"></div>
    </div>
}

@code {
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 50;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public List<DateTime> Dates { get; set; } = new();
    [Parameter] public string SortField { get; set; } = "date";
    [Parameter] public EventCallback<int> OnPageRequested { get; set; }

    private List<TimelineMath.Tick> _ticks = new();
    private double _thumbTop, _thumbHeight;
    private DotNetObjectReference<ArticleTimeline>? _ref;

    protected override void OnParametersSet()
    {
        _ticks = SortField is "date" or "dateAsc" ? TimelineMath.BuildTicks(Dates) : new();
        _thumbHeight = TimelineMath.ThumbHeightPercent(PageSize, TotalCount);
        _thumbTop = TimelineMath.ThumbTopPercent(CurrentPage, TotalPages);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            var dates = Dates.Select(d => d.ToString("yyyy-MM-dd")).ToArray();
            await JS.InvokeVoidAsync("vigie24.initTimeline", _ref, TotalPages, PageSize, TotalCount, dates, SortField);
        }
        else
        {
            await JS.InvokeVoidAsync("vigie24.updateTimeline", CurrentPage, TotalPages);
        }
    }

    private double TickPercent(TimelineMath.Tick tick)
    {
        if (Dates.Count == 0) return 0;
        var span = (Dates.Max() - Dates.Min()).TotalDays;
        return span <= 0 ? 0 : (tick.Start - Dates.Min().Date).TotalDays / span * 100.0;
    }

    [JSInvokable]
    public Task OnJump(int page) => OnPageRequested.InvokeAsync(page);

    public void Dispose()
    {
        _ref?.Dispose();
        _ref = null;
    }
}
