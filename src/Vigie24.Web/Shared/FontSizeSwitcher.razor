@using Microsoft.JSInterop
@inject IJSRuntime JS

@* Sélecteur de taille du texte (50 % → 150 %), persistant (localStorage).
   Appliqué via data-font sur <html> (font-size racine, tout le texte suit en rem). *@
<span class="font-switcher">
    <select @bind="Font" @bind:after="ApplyFont" aria-label="Taille du texte">
        <option value="50">Aa 50 %</option>
        <option value="75">Aa 75 %</option>
        <option value="100">Aa 100 %</option>
        <option value="125">Aa 125 %</option>
        <option value="150">Aa 150 %</option>
    </select>
</span>

@code {
    private string Font { get; set; } = "100";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var current = await JS.InvokeAsync<string>("vigie24Font.get");
            if (!string.IsNullOrEmpty(current)) Font = current;
            StateHasChanged();
        }
        catch
        {
            // JS unavailable (prerender): keep the default size
        }
    }

    private async Task ApplyFont()
    {
        try
        {
            await JS.InvokeVoidAsync("vigie24Font.set", Font);
        }
        catch
        {
            // silently: the size will be applied on the next load
        }
    }
}
