@page "/"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Services.Interfaces
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IAiService AiService
@inject Vigie24DbContext DbContext
@inject ILogger<Index> Logger

<PageTitle>Accueil - Vigie24</PageTitle>

<h1>Vigie24</h1>
<p class="muted">Surveillance RSS et analyse IA</p>

@if (AiService == null)
{
    <div class="alert alert-danger" role="alert">
        <strong>⚠️ Erreur critique :</strong> Le service IA n'est pas configuré.
    </div>
}
else
{
    <div class="status-card">
        <strong>Fournisseur IA :</strong> @AiService.ProviderName (@AiService.GetType().Name)<br />
        <strong>Modèle LLM :</strong> @AiService.ModelName<br />
        <strong>Statut :</strong> <span class="text-success">Opérationnel</span> · <strong>Articles en base :</strong> @_totalArticles
    </div>
}

<div class="page-head">
    <h2>Derniers articles</h2>
    <div class="chips">
        <a class="chip chip-cat" href="/categories">🗂 Catégories</a>
        <a class="chip chip-tag" href="/themes">🏷 Thématiques</a>
    </div>
</div>

<TimelineFilter Articles="@_articles" Range="@_range" RangeChanged="@OnRangeChanged" />

@if (!_articles.Any())
{
    <div class="alert alert-warning" role="alert">
        Aucun article pour le moment. Le worker va en générer dans quelques minutes.
    </div>
}
else
{
    var visible = FilteredArticles(_articles).ToList();
    @if (!visible.Any())
    {
        <div class="alert alert-warning" role="alert">Aucun article sur ce créneau. Choisissez un autre intervalle.</div>
    }
    else
    {
        <div class="article-grid">
            @foreach (var article in visible)
            {
                <ArticleCard Article="@article" />
            }
        </div>
    }
}

@code {
    private List<Article> _articles = new();
    private int _totalArticles;
    private (DateTime? From, DateTime? To)? _range;

    protected override async Task OnInitializedAsync()
    {
        _totalArticles = await DbContext.Articles.CountAsync();
        _articles = await DbContext.Articles
            .Include(a => a.Category).ThenInclude(c => c!.ParentCategory)
            .Include(a => a.Authors).ThenInclude(a => a.Author)
            .Include(a => a.Sources).ThenInclude(s => s.Source)
            .Include(a => a.Tags).ThenInclude(t => t.Tag)
            .Where(a => a.IsPublished)
            .OrderByDescending(a => a.PublishedAt)
            .ToListAsync();
        Logger.LogInformation("Index : {Count} articles publiés chargés", _articles.Count);
    }

    private IEnumerable<Article> FilteredArticles(IEnumerable<Article> articles)
    {
        if (_range is null) return articles;
        var (from, to) = _range.Value;
        return articles.Where(a =>
            (!from.HasValue || a.PublishedAt >= from.Value) &&
            (!to.HasValue || a.PublishedAt < to.Value));
    }

    private Task OnRangeChanged((DateTime? From, DateTime? To)? range)
    {
        _range = range;
        return Task.CompletedTask;
    }
}
