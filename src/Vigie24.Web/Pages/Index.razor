@page "/"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Services.Interfaces
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject IAiService AiService
@inject Vigie24DbContext DbContext
@inject ILogger<Index> Logger

<PageTitle>Accueil - Vigie24</PageTitle>

<h1>Vigie24</h1>
<p class="muted">Surveillance RSS et analyse IA</p>

@if (AiService == null)
{
    <div class="alert alert-danger" role="alert">
        <strong>⚠️ Erreur critique :</strong> Le service IA n'est pas configuré.
    </div>
}
else
{
    <div class="status-card">
        <strong>Fournisseur IA :</strong> @AiService.ProviderName (@AiService.GetType().Name)<br />
        <strong>Modèle LLM :</strong> @AiService.ModelName<br />
        <strong>Statut :</strong> <span class="text-success">Opérationnel</span> · <strong>Articles en base :</strong> @_totalArticles
    </div>
}

<div class="page-head">
    <h2>Derniers articles</h2>
    <div class="chips">
        <a class="chip chip-cat" href="/categories">🗂 Catégories</a>
        <a class="chip chip-tag" href="/themes">🏷 Thématiques</a>
    </div>
</div>

<ArticleBrowser Source="@BuildQuery" />

@code {
    private int _totalArticles;

    protected override async Task OnInitializedAsync()
    {
        _totalArticles = await DbContext.Articles.CountAsync();
        Logger.LogInformation("Index : {Count} articles en base", _totalArticles);
    }

    /// <summary>Requête de base : articles publiés avec leurs relations (recherche/tri/pagination gérés par ArticleBrowser)</summary>
    private IQueryable<Article> BuildQuery() => DbContext.Articles
        .Include(a => a.Category).ThenInclude(c => c!.ParentCategory)
        .Include(a => a.Authors).ThenInclude(a => a.Author)
        .Include(a => a.Sources).ThenInclude(s => s.Source)
        .Include(a => a.Tags).ThenInclude(t => t.Tag)
        .Where(a => a.IsPublished);
}
