@page "/"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Services.Interfaces
@using Vigie24.Infrastructure.Data
@using Vigie24.Web.Services
@using Microsoft.EntityFrameworkCore
@inject IAiService AiService
@inject Vigie24DbContext DbContext
@inject IHealthCheckService Health
@inject AiServiceSettings AiSettings
@inject ILogger<Index> Logger

<PageTitle>Accueil - Vigie24</PageTitle>
<HeadContent>
    <meta name="description" content="Vigie24 — veille technologique francophone : articles sélectionnés et analysés par IA (France, Suisse, Belgique, Québec, Luxembourg)." />
    <link rel="canonical" href="https://vigie24.info/" />
    <meta property="og:title" content="Vigie24 - Surveillance RSS et analyse IA" />
    <meta property="og:description" content="Veille technologique francophone : articles sélectionnés et analysés par IA." />
    <meta property="og:url" content="https://vigie24.info/" />
    <meta property="og:type" content="website" />
</HeadContent>

<h1>Vigie24</h1>
<p class="muted">Surveillance RSS et analyse IA</p>

@if (AiService == null)
{
    <div class="alert alert-danger" role="alert">
        <strong>⚠️ Erreur critique :</strong> Le service IA n'est pas configuré.
    </div>
}
else
{
    <div class="status-card">
        <strong>Fournisseur IA :</strong> @AiService.ProviderName (@AiService.GetType().Name)<br />
        <strong>Modèle LLM :</strong> @AiService.ModelName<br />
        <strong>Statut :</strong> <span class="@_status?.CssClass">@_status?.Label</span> · <strong>Dernière ingestion :</strong> @_lastIngestionText<br />
        <strong>Articles en base :</strong> @_totalArticles<br />
        <strong>Coût IA aujourd'hui :</strong> @FormatTokens(_todayTokens)&nbsp;tokens&nbsp;·&nbsp;≈&nbsp;CHF&nbsp;@FormatCost(_todayCostChf)&nbsp;·&nbsp;<a class="nowrap" href="/couts" title="Graphiques des coûts IA (1 semaine, 1 mois, 1 an)">📊&nbsp;voir les coûts</a>
    </div>
}

<a class="debate-banner" href="/debats" title="Voir les articles contradictoires mis en parallèle">
    <span class="debate-banner-icon">🥊</span>
    <span class="debate-banner-text">
        <strong>Débats en cours</strong> — @_debateCount débat(s) actif(s) : des articles contradictoires sur un même sujet, mis en parallèle
    </span>
    <span class="debate-banner-cta">Voir les débats →</span>
</a>

<div class="page-head">
    <h2>Derniers articles</h2>
    <div class="chips">
        <a class="chip chip-cat" href="/categories">🗂 Catégories</a>
        <a class="chip chip-tag" href="/themes">🏷 Thématiques</a>
    </div>
</div>

<ArticleBrowser Filter="@BuildFilter" />

@code {
    private int _totalArticles;
    private HealthStatus? _status;
    private string _lastIngestionText = "jamais";
    private long _todayTokens;
    private decimal _todayCostChf;
    private int _debateCount;

    protected override async Task OnInitializedAsync()
    {
        _totalArticles = await DbContext.Articles.CountAsync();
        _status = await Health.GetStatusAsync();
        _debateCount = await DbContext.Debates.CountAsync();
        _lastIngestionText = _status.LastIngestionUtc is { } last
            ? HealthEvaluator.FormatAge(DateTime.UtcNow - last)
            : "jamais";

        // Coût IA du jour : somme des tokens consommés par les analyses du jour, convertie en CHF
        var today = DateTime.UtcNow.Date;
        var prompt = await DbContext.Articles
            .Where(a => a.PromptTokens != null && a.UpdatedAt >= today)
            .SumAsync(a => (long)a.PromptTokens!);
        var completion = await DbContext.Articles
            .Where(a => a.CompletionTokens != null && a.UpdatedAt >= today)
            .SumAsync(a => (long)a.CompletionTokens!);
        _todayTokens = prompt + completion;
        _todayCostChf = AiCost.Calculate(
            (int)prompt, (int)completion,
            AiSettings.InputPricePerMillionTokens, AiSettings.OutputPricePerMillionTokens);

        Logger.LogInformation("Index : {Count} articles en base, statut santé {Status}", _totalArticles, _status.Label);
    }

    private string FormatTokens(long tokens)
        => tokens.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));

    private string FormatCost(decimal cost)
        => cost >= 0.01m
            ? cost.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"))
            : cost.ToString("0.0000", System.Globalization.CultureInfo.GetCultureInfo("fr-FR"));

    /// <summary>Filtre de base : articles publiés (recherche/tri/pagination gérés par ArticleBrowser sur son propre contexte)</summary>
    private System.Linq.Expressions.Expression<Func<Article, bool>> BuildFilter() => a => a.IsPublished;
}
