@page "/categories"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext

<PageTitle>Catégories - Vigie24</PageTitle>
<HeadContent>
    <meta name="description" content="Parcourez les articles de veille technologique Vigie24 par catégorie et sous-catégorie : IA, développement, cybersécurité, science, hardware, divertissements, musiques, arts graphiques." />
    <link rel="canonical" href="https://vigie24.info/categories" />
    <meta property="og:title" content="Catégories - Vigie24" />
    <meta property="og:description" content="Parcourez les articles de veille technologique Vigie24 par catégorie et sous-catégorie." />
    <meta property="og:url" content="https://vigie24.info/categories" />
    <meta property="og:type" content="website" />
</HeadContent>

<h1>Catégories</h1>
<p class="muted">Parcourez les articles par thématique et sous-catégorie.</p>

@if (_parents.Any())
{
    <button class="btn-toggle" style="margin-bottom:1rem;" @onclick="ToggleSort"
            aria-pressed="@_sortByVolume">
        @(_sortByVolume ? "Tri : par volume" : "Tri : ordre taxonomique")
    </button>
}

@if (!_parents.Any())
{
    <div class="alert alert-warning" role="alert">Aucune catégorie pour le moment.</div>
}
else
{
    <div class="tree">
        @foreach (var parent in _orderedParents)
        {
            <div class="tree-card">
                <h3>
                    <a href="/categories/@parent.Slug">@VigieTaxonomy.DisplayName(parent.Slug)</a>
                    <span class="count-badge">@_counts.GetValueOrDefault(parent.Id)</span>
                </h3>
                @foreach (var sub in _orderedSubs.GetValueOrDefault(parent.Id) ?? new List<Category>())
                {
                    <div class="tree-sub @(_counts.GetValueOrDefault(sub.Id) == 0 ? "is-empty" : "")">
                        <a href="/categories/@sub.Slug">@VigieTaxonomy.DisplayName(sub.Slug)</a>
                        <span class="count-badge">@_counts.GetValueOrDefault(sub.Id)</span>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Category> _parents = new();
    private Dictionary<Guid, List<Category>> _subs = new();
    private Dictionary<Guid, int> _counts = new();
    private bool _sortByVolume;

    private List<Category> _orderedParents => _sortByVolume
        ? _parents.OrderByDescending(p => _counts.GetValueOrDefault(p.Id)).ToList()
        : _parents;

    private Dictionary<Guid, List<Category>> _orderedSubs => _sortByVolume
        ? _subs.ToDictionary(
            kv => kv.Key,
            kv => kv.Value.OrderByDescending(s => _counts.GetValueOrDefault(s.Id)).ToList())
        : _subs;

    private void ToggleSort() => _sortByVolume = !_sortByVolume;

    protected override async Task OnInitializedAsync()
    {
        var all = await DbContext.Categories.AsNoTracking().ToListAsync();
        _parents = all.Where(c => c.ParentCategoryId is null)
            .OrderBy(c => c.DisplayOrder).ThenBy(c => c.Slug).ToList();
        _subs = _parents.ToDictionary(
            p => p.Id,
            p => all.Where(c => c.ParentCategoryId == p.Id).OrderBy(c => c.Slug).ToList());

        // Counts: article categorized in the category OR (parent category) in one of its subcategories
        var articles = await (
            from a in DbContext.Articles
            join c in DbContext.Categories on a.CategoryId equals c.Id into cj
            from c in cj.DefaultIfEmpty()
            select new { a.CategoryId, ParentId = c != null ? c.ParentCategoryId : null })
            .AsNoTracking().ToListAsync();

        foreach (var cat in all)
        {
            _counts[cat.Id] = articles.Count(a =>
                a.CategoryId == cat.Id ||
                (cat.ParentCategoryId is null && a.ParentId == cat.Id));
        }
    }
}
