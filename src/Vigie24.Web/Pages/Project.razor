@code {
    private static readonly System.Globalization.CultureInfo Culture =
        System.Globalization.CultureInfo.GetCultureInfo("fr-FR");

    private int _activeSources;
    private int _totalSources;
    private int _articles;
    private int _categories;
    private int _debates;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Chiffres réels (affichés sur la page) — jamais de valeurs figées.
            _activeSources = await DbContext.Sources.CountAsync(s => s.IsActive);
            _totalSources = await DbContext.Sources.CountAsync();
            _articles = await DbContext.Articles.CountAsync();
            _categories = await DbContext.Categories.CountAsync();
            _debates = await DbContext.Debates.CountAsync();
        }
        catch (Exception ex)
        {
            // Page résiliente : sans base, on affiche les libellés sans chiffres.
            _activeSources = _totalSources = 0;
            Console.WriteLine($"Project stats error: {ex.Message}");
        }
    }
}
