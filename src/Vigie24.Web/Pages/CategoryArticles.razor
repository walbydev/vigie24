@page "/categories/{Slug}"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext

<PageTitle>@_title - Vigie24</PageTitle>

@if (_category == null)
{
    <div class="alert alert-warning" role="alert">Catégorie introuvable.</div>
}
else
{
    <div class="breadcrumb">
        <a href="/categories">Catégories</a>
        @if (_parent != null)
        {
            <text> › <a href="/categories/@_parent.Slug">@VigieTaxonomy.DisplayName(_parent.Slug)</a></text>
        }
        <text> › <strong>@VigieTaxonomy.DisplayName(_category.Slug)</strong></text>
    </div>

    <div class="page-head">
        <h1>@_title</h1>
        <span class="muted">@_articles.Count article(s)</span>
    </div>

    <TimelineFilter Articles="@_articles" Range="@_range" RangeChanged="@OnRangeChanged" />

    @if (!_articles.Any())
    {
        <div class="alert alert-warning" role="alert">Aucun article publié dans cette catégorie.</div>
    }
    else
    {
        var visible = FilteredArticles(_articles).ToList();
        @if (!visible.Any())
        {
            <div class="alert alert-warning" role="alert">Aucun article sur ce créneau.</div>
        }
        else
        {
            <div class="article-grid">
                @foreach (var article in visible)
                {
                    <ArticleCard Article="@article" />
                }
            </div>
        }
    }
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Category? _category;
    private Category? _parent;
    private List<Article> _articles = new();
    private (DateTime? From, DateTime? To)? _range;
    private string _title = "";

    protected override async Task OnInitializedAsync()
    {
        _category = await DbContext.Categories.FirstOrDefaultAsync(c => c.Slug == Slug);
        if (_category == null) return;

        _title = VigieTaxonomy.DisplayName(_category.Slug);
        if (_category.ParentCategoryId is Guid parentId)
            _parent = await DbContext.Categories.FindAsync(parentId);

        _articles = await DbContext.Articles
            .Include(a => a.Category).ThenInclude(c => c!.ParentCategory)
            .Include(a => a.Authors).ThenInclude(a => a.Author)
            .Include(a => a.Sources).ThenInclude(s => s.Source)
            .Include(a => a.Tags).ThenInclude(t => t.Tag)
            .Where(a => a.IsPublished &&
                        (a.CategoryId == _category.Id ||
                         (_category.ParentCategoryId == null && a.Category!.ParentCategoryId == _category.Id)))
            .OrderByDescending(a => a.PublishedAt)
            .ToListAsync();
    }

    private IEnumerable<Article> FilteredArticles(IEnumerable<Article> articles)
    {
        if (_range is null) return articles;
        var (from, to) = _range.Value;
        return articles.Where(a =>
            (!from.HasValue || a.PublishedAt >= from.Value) &&
            (!to.HasValue || a.PublishedAt < to.Value));
    }

    private Task OnRangeChanged((DateTime? From, DateTime? To)? range)
    {
        _range = range;
        return Task.CompletedTask;
    }
}
