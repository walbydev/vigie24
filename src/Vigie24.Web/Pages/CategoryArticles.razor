@page "/categories/{Slug}"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext

<PageTitle>@_title - Vigie24</PageTitle>
<HeadContent>
    <meta name="description" content="@_metaDescription" />
    <link rel="canonical" href="https://vigie24.info/categories/@Slug" />
    <meta property="og:title" content="@_title - Vigie24" />
    <meta property="og:description" content="@_metaDescription" />
    <meta property="og:url" content="https://vigie24.info/categories/@Slug" />
    <meta property="og:type" content="website" />
    @if (!string.IsNullOrEmpty(_breadcrumbJsonLd))
    {
        <script type="application/ld+json">@_breadcrumbJsonLd</script>
    }
</HeadContent>

@if (_category == null)
{
    <div class="alert alert-warning" role="alert">Catégorie introuvable.</div>
}
else
{
    <div class="breadcrumb">
        <a href="/categories">Catégories</a>
        @if (_parent != null)
        {
            <text> › <a href="/categories/@_parent.Slug">@VigieTaxonomy.DisplayName(_parent.Slug)</a></text>
        }
        <text> › <strong>@VigieTaxonomy.DisplayName(_category.Slug)</strong></text>
    </div>

    <div class="page-head">
        <h1>@_title</h1>
        <span class="muted">@_categoryCount article(s)</span>
        <a class="chip" href="/categories/@_category.Slug/feed" rel="alternate" type="application/rss+xml" title="S'abonner au flux RSS de cette catégorie">📡 RSS</a>
    </div>

    <ArticleBrowser Filter="@BuildFilter" RssPath="@("/categories/" + Slug + "/feed")" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Category? _category;
    private Category? _parent;
    private string _title = "";
    private string _metaDescription = "";
    private string _breadcrumbJsonLd = "";
    private int _categoryCount;

    protected override async Task OnInitializedAsync()
    {
        // Title computed SYNCHRONOUSLY before any await → visible in the initial HTML (prerender)
        _title = VigieTaxonomy.DisplayName(Slug);
        _category = await DbContext.Categories.FirstOrDefaultAsync(c => c.Slug == Slug);
        if (_category == null)
        {
            _title = "Catégorie introuvable";
            _metaDescription = "Cette catégorie n'existe pas sur Vigie24.";
            return;
        }

        _metaDescription = $"Articles de la catégorie {_title} — veille technologique francophone Vigie24.";
        if (_category.ParentCategoryId is Guid parentId)
            _parent = await DbContext.Categories.FindAsync(parentId);

        _categoryCount = await DbContext.Articles
            .CountAsync(a => a.IsPublished &&
                (a.CategoryId == _category.Id ||
                 (_category.ParentCategoryId == null && a.Category!.ParentCategoryId == _category.Id)));

        BuildBreadcrumbJsonLd();
    }

    /// <summary>Structured BreadcrumbList data (Google rich snippet): Home › Categories › [Parent ›] Category</summary>
    private void BuildBreadcrumbJsonLd()
    {
        var items = new List<object>
        {
            new { position = 1, name = "Accueil", item = "https://vigie24.info/" },
            new { position = 2, name = "Catégories", item = "https://vigie24.info/categories" }
        };
        var pos = 3;
        if (_parent != null)
            items.Add(new { position = pos++, name = VigieTaxonomy.DisplayName(_parent.Slug), item = $"https://vigie24.info/categories/{_parent.Slug}" });
        items.Add(new { position = pos, name = _title, item = $"https://vigie24.info/categories/{Slug}" });

        _breadcrumbJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = items
        });
    }

    /// <summary>Base filter: published articles of the category (search/sort/pagination handled by ArticleBrowser)</summary>
    private System.Linq.Expressions.Expression<Func<Article, bool>> BuildFilter() =>
        a => a.IsPublished &&
             (a.CategoryId == _category!.Id ||
              (_category.ParentCategoryId == null && a.Category!.ParentCategoryId == _category.Id));
}
