@page "/sources"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext
@inject ILogger<Sources> Logger
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject System.Net.Http.HttpClient Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<PageTitle>Sources - Vigie24</PageTitle>
<HeadContent>
    <meta name="description" content="Les sources d'information surveillées par Vigie24 : presse, blogs, chaînes YouTube et subreddits francophones, analysées par IA à chaque publication." />
    <link rel="canonical" href="https://vigie24.info/sources" />
    <meta property="og:title" content="Sources - Vigie24" />
    <meta property="og:description" content="Les sources d'information surveillées par Vigie24 : presse, blogs, chaînes YouTube et subreddits francophones, analysées par IA." />
    <meta property="og:url" content="https://vigie24.info/sources" />
    <meta property="og:type" content="website" />
</HeadContent>

<h1>Sources d'information</h1>
<p class="muted">
    Les @_sources.Count sources surveillées par Vigie24 — flux RSS/Atom, chaînes YouTube et subreddits,
    analysées par IA à chaque publication.
</p>

@if (_uiMessage is not null)
{
    <div class="alert @(_uiMessage.StartsWith("✅") ? "alert-success" : "alert-danger")">@_uiMessage</div>
}

<div class="status-card">
    <div class="source-stats">
        <span class="source-stat"><strong>@_sources.Count</strong> sources au total</span>
        <span class="source-stat">✅ <strong>@_activeCount</strong> actives</span>
        <span class="source-stat">⏸️ <strong>@_inactiveCount</strong> désactivées</span>
        <span class="source-export">
            <span class="muted">API pour développeurs :</span>
            <a class="chip" href="/sources.json" download="vigie24-sources.json" title="Télécharger la liste des sources en JSON">⬇️ JSON</a>
            <a class="chip" href="/sources.xml" download="vigie24-sources.xml" title="Télécharger la liste des sources en XML">⬇️ XML</a>
        </span>
    </div>
</div>

@if (_failedSources.Count > 0)
{
    <h2>🚨 Rapport d'échecs</h2>
    <p class="muted">
        Sources en échec de récupération — désactivation automatique après
        <strong>@SourceFailurePolicy.DefaultMaxFailures échecs consécutifs</strong>.
        Une source désactivée est re-testée automatiquement après 24 h.
    </p>
    <div class="source-grid">
        @foreach (var source in _failedSources)
        {
            <div class="source-card @(source.IsActive ? "" : "source-disabled")">
                <div class="source-body">
                    <div class="source-name">
                        @source.Name
                        @if (!source.IsActive) { <span class="source-badge source-badge-off">⏸️ Désactivée</span> }
                    </div>
                    <div class="source-meta">
                        <span>@_kindDisplay(source.SourceKind)</span>
                        <span>·</span>
                        <span>⚠️ @source.FetchFailureCount échec(s) consécutif(s)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(source.DisabledReason))
                    {
                        <div class="source-meta">💡 @source.DisabledReason</div>
                        @if (source.DisabledAt is { } disabledAt)
                        {
                            <div class="source-meta">🗓️ Désactivée le @disabledAt.ToLocalTime().ToString("d MMM yyyy 'à' HH:mm")</div>
                        }
                        @if (_adminEnabled)
                        {
                            <button type="button" class="btn-toggle source-reactivate" @onclick="() => ReactivateAsync(source.Id)">↩️ Réactiver</button>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

@foreach (var group in _groups)
{
    <div class="source-group-title">
        <h2>@group.Emoji @group.Label</h2>
        <span class="count">@group.Sources.Count</span>
    </div>

    <div class="source-grid">
        @foreach (var source in group.Sources)
        {
            var favicon = SourceFavicon(source.WebsiteUrl);
            <div class="source-card @(source.IsActive ? "" : "source-disabled")">
                @if (!string.IsNullOrEmpty(favicon))
                {
                    <img src="@favicon" class="source-favicon" alt="" loading="lazy" onerror="this.remove()" />
                }
                <div class="source-body">
                    <div class="source-name">
                        @source.Name
                        @if (!source.IsActive)
                        {
                            <span class="source-badge source-badge-off">⏸️ Désactivée</span>
                        }
                        @if (source.FetchFailureCount > 0)
                        {
                            <span class="source-badge source-badge-warn" title="Échecs de récupération consécutifs">⚠️ @source.FetchFailureCount</span>
                        }
                    </div>
                    <div class="source-meta">
                        @if (!string.IsNullOrEmpty(source.CountryCode))
                        {
                            <span class="country">
                                @if (CountryInfo.FlagUrl(source.CountryCode) is { } flagUrl)
                                {
                                    <img class="flag-icon" src="@flagUrl" alt="" loading="lazy" />
                                }
                                @CountryInfo.Name(source.CountryCode)
                            </span>
                            <span>·</span>
                        }
                        <span>@_langDisplay(source.LanguageCode)</span>
                        <span>·</span>
                        <span>@_kindDisplay(source.SourceKind)</span>
                    </div>
                    <div class="source-links">
                        @if (!string.IsNullOrEmpty(source.WebsiteUrl))
                        {
                            <a href="@source.WebsiteUrl" target="_blank" rel="noopener">🌐 Site</a>
                        }
                        @if (!string.IsNullOrEmpty(source.FeedUrl))
                        {
                            <a href="@source.FeedUrl" target="_blank" rel="noopener">@_feedIcon(source.SourceKind) Flux</a>
                        }
                    </div>
                    <div class="source-meta">
                        @if (source.LastIngestedAt is { } last)
                        {
                            <span>Dernière ingestion : @RelativeTime(last)</span>
                        }
                        else
                        {
                            <span>Jamais ingérée</span>
                        }
                        @if (_scoops.TryGetValue(source.Id, out var scoops) && scoops > 0)
                        {
                            <span class="source-scoop" title="Nombre de débats où cette source a été la première à couvrir le sujet">🏁 @scoops scoop(s)</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Source> _sources = new();
    private List<(string Emoji, string Label, List<Source> Sources)> _groups = new();
    private Dictionary<Guid, int> _scoops = new();
    private List<Source> _failedSources = new();
    private int _activeCount;
    private int _inactiveCount;
    private bool _adminEnabled;
    private string? _uiMessage;

    protected override async Task OnInitializedAsync()
    {
        // Admin authentifié par le token (cookie HttpOnly vigie24_admin posé par
        // /api/admin/verify) — le bouton de réactivation reste invisible sinon.
        _adminEnabled = !string.IsNullOrEmpty(Config["Admin:ReactivateToken"])
            && HttpContextAccessor.HttpContext?.Request.Cookies["vigie24_admin"] == "1";

        try
        {
            _sources = await DbContext.Sources.AsNoTracking()
                .OrderBy(s => s.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Impossible de charger les sources");
        }

        _activeCount = _sources.Count(s => s.IsActive);
        _inactiveCount = _sources.Count - _activeCount;

        // « Rapport d'échecs » : sources en échec de récupération (compteur
        // consécutif) ou désactivées automatiquement par le worker.
        _failedSources = _sources
            .Where(s => s.FetchFailureCount > 0 || !string.IsNullOrEmpty(s.DisabledReason))
            .OrderByDescending(s => s.FetchFailureCount)
            .ToList();

        // « Scoops » : pour chaque débat (sujet couvert par plusieurs médias), la source
        // du premier article publié marque un scoop. Les articles étant mono-source en
        // pratique, c'est la comparaison entre articles du même débat qui donne le signal.
        var debates = await DbContext.Debates.AsNoTracking()
            .Where(d => d.UpdatedAt >= DateTime.UtcNow.AddDays(-30))
            .Include(d => d.Articles)
                .ThenInclude(da => da.Article)
                .ThenInclude(a => a.Sources)
                .ThenInclude(s => s.Source)
            .ToListAsync();
        _scoops = new Dictionary<Guid, int>();
        foreach (var debate in debates)
        {
            var first = debate.Articles
                .OrderBy(da => da.Article.PublishedAt)
                .Select(da => da.Article.Sources.FirstOrDefault(s => s.IsPrimary) ?? da.Article.Sources.FirstOrDefault())
                .FirstOrDefault(x => x?.Source != null);
            if (first?.Source != null)
                _scoops[first.Source.Id] = _scoops.GetValueOrDefault(first.Source.Id) + 1;
        }

        _groups = new List<(string, string, List<Source>)>
        {
            ("📰", "Presse", _sources.Where(s => s.SourceKind == nameof(SourceKind.Press)).ToList()),
            ("✍️", "Blogs", _sources.Where(s => s.SourceKind == nameof(SourceKind.BlogLab)).ToList()),
            ("📺", "YouTube", _sources.Where(s => s.SourceKind == nameof(SourceKind.Youtube)).ToList()),
            ("💬", "Reddit", _sources.Where(s => s.SourceKind == nameof(SourceKind.Reddit)).ToList()),
            ("🗂", "Autres", _sources.Where(s => s.SourceKind == nameof(SourceKind.Other)).ToList()),
        }.Where(g => g.Item3.Count > 0).Select(g => (g.Item1, g.Item2, g.Item3)).ToList();
    }

    private async Task ReactivateAsync(Guid sourceId)
    {
        _uiMessage = null;
        try
        {
            // Session admin requise : le cookie HttpOnly vigie24_admin est joint
            // automatiquement à la requête par le navigateur.
            var response = await Http.PostAsync($"/api/sources/{sourceId}/reactivate", null);
            _uiMessage = response.IsSuccessStatusCode
                ? "✅ Source réactivée."
                : "❌ Action refusée.";
            if (response.IsSuccessStatusCode)
            {
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors de la réactivation de la source {SourceId}", sourceId);
            _uiMessage = "❌ Erreur réseau — réessaie.";
        }
    }

    private static string SourceFavicon(string websiteUrl)
        => Uri.TryCreate(websiteUrl, UriKind.Absolute, out var site)
            ? $"{site.Scheme}://{site.Host}/favicon.ico"
            : "";

    private static string _kindDisplay(string kind) => kind switch
    {
        nameof(SourceKind.Press) => "Presse · RSS/Atom",
        nameof(SourceKind.BlogLab) => "Blog · RSS/Atom",
        nameof(SourceKind.Youtube) => "YouTube · Atom",
        nameof(SourceKind.Reddit) => "Reddit · RSS",
        _ => kind
    };

    private static string _feedIcon(string kind) => kind switch
    {
        nameof(SourceKind.Youtube) => "📺",
        nameof(SourceKind.Reddit) => "💬",
        _ => "📡"
    };

    private static string _langDisplay(string code) => code.ToLowerInvariant() switch
    {
        "fr" => "Français",
        "en" => "Anglais",
        "de" => "Allemand",
        "it" => "Italien",
        "nl" => "Néerlandais",
        "es" => "Espagnol",
        _ => code
    };

    private static string RelativeTime(DateTime utc)
    {
        var delta = DateTime.UtcNow - utc;
        return delta switch
        {
            { TotalMinutes: < 1 } => "à l'instant",
            { TotalMinutes: < 60 } => $"il y a {(int)delta.TotalMinutes} min",
            { TotalHours: < 24 } => $"il y a {(int)delta.TotalHours} h",
            { TotalDays: < 30 } => $"il y a {(int)delta.TotalDays} j",
            _ => utc.ToString("d MMM yyyy")
        };
    }
}
