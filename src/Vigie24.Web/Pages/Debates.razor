@page "/debats"
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext
@inject ILogger<Debates> Logger

<PageTitle>Débats - Vigie24</PageTitle>

<h1>Débats</h1>
<p class="muted">
    La mise en parallèle d'articles contradictoires pour illustrer un débat ou un propos —
    chaque débat regroupe des articles traitant du même sujet avec des positions opposées.
</p>

@if (_debates.Count == 0)
{
    <div class="status-card">
        <p class="muted">Aucun débat détecté pour le moment. Dès que deux sources publieront des positions opposées sur un même sujet, elles apparaîtront ici.</p>
    </div>
}

@foreach (var debate in _debates)
{
    var camps = new[]
    {
        ("pour", "🟢 Pour"),
        ("contre", "🔴 Contre"),
        ("nuance", "🟡 Nuancé"),
        ("neutre", "⚪ Neutre")
    };

    <div class="debate-card">
        <div class="debate-head">
            <h2>🥊 @debate.DisplayTopic</h2>
            <span class="count">@debate.Articles.Count articles</span>
        </div>
        <div class="debate-camps">
            @foreach (var camp in camps)
            {
                var articles = debate.Articles
                    .Where(a => string.Equals(a.Stance, camp.Item1, StringComparison.OrdinalIgnoreCase))
                    .OrderByDescending(a => a.Article.PublishedAt)
                    .ToList();
                if (articles.Count == 0)
                {
                    continue;
                }
                <div class="debate-camp debate-camp-@camp.Item1">
                    <h3>@camp.Item2 <span class="count">@articles.Count</span></h3>
                    @foreach (var link in articles)
                    {
                        var sourceName = link.Article.Sources.FirstOrDefault()?.Source.Name;
                        <div class="debate-article">
                            <a href="/api/articles/@link.ArticleId/track" target="_blank" rel="noopener">@link.Article.Title</a>
                            <span class="muted">
                                @link.Article.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                @if (!string.IsNullOrEmpty(sourceName))
                                {
                                    <text>· via @sourceName</text>
                                }
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private List<Debate> _debates = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _debates = await DbContext.Debates.AsNoTracking()
                .Where(d => d.UpdatedAt >= DateTime.UtcNow.AddDays(-30))
                .OrderByDescending(d => d.UpdatedAt)
                .Include(d => d.Articles)
                    .ThenInclude(da => da.Article)
                    .ThenInclude(a => a.Sources)
                    .ThenInclude(s => s.Source)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Impossible de charger les débats");
        }
    }
}
