@page "/"
@namespace Vigie24.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components.Web
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // "Mode Radar" brand theme (petrol blue / teal / amber) — utilisé en staging ET en prod.
    // Les palettes haut contraste sont redéfinies dans ce bloc (après :root) pour ne pas être
    // écrasées par lui (même spécificité, ordre source).
    var isRadarBranding = string.Equals(Config["Branding:Theme"], "radar", StringComparison.OrdinalIgnoreCase);

    // La fiche article fournit ses propres og:type / og:image / twitter:image (image de l'article,
    // og:type=article) : on n'émet les valeurs génériques que sur les autres pages, pour éviter
    // des balises dupliquées que les crawlers interprètent mal.
    var requestPath = HttpContext.Request.Path.Value ?? "/";
    var isArticleDetail = requestPath.StartsWith("/articles/", StringComparison.OrdinalIgnoreCase)
        && Guid.TryParse(requestPath["/articles/".Length..].TrimEnd('/'), out _);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Le <title> et les meta par page sont fournis par <PageTitle>/<HeadContent> (rendus ici pendant le prerender).
       Dans une Razor Page, un composant se déclare via le tag helper <component> — ServerPrerendered pour
       qu'il soit présent dans le HTML initial ET hydraté pour les navigations SPA. *@
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <base href="~/" />
    <link rel="alternate" type="application/rss+xml" title="Vigie24 — Flux RSS complet" href="/feed" />
    @* Meta globaux invariants (Open Graph / Twitter). La description, le canonical et
       og:title/og:url sont fournis PAR PAGE via <HeadContent> (évite les doublons). *@
    <meta property="og:site_name" content="Vigie24" />
    <meta property="og:locale" content="fr_FR" />
    @if (!isArticleDetail)
    {
        <meta property="og:type" content="website" />
        <meta property="og:image" content="https://vigie24.info/og-image.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content="https://vigie24.info/og-image.png" />
    }
    @if (isRadarBranding)
    {
        <link rel="icon" type="image/x-icon" href="/favicon-radar.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-radar-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    }
    else
    {
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    }
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    @if (isRadarBranding)
    {
        @* ============================================================
           Charte graphique « Mode Radar » (specs originales) :
           bleu pétrole #1B4B5A · vert-sarcelle #5FB5A3/#EEF5F3 · ambre #E8A33D
           Inter (corps) · Space Grotesk (titres) · JetBrains Mono (données)
           ============================================================ *@
        <link rel="stylesheet" href="~/css/radar.min.css" asp-append-version="true" />
    }
    <script>
    // Anti-flash: theme/font from localStorage (else system preference) before first render
    (function(){var s=null;try{s=localStorage.getItem('vigie24-theme')}catch(e){}if(!s)s=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';document.documentElement.setAttribute('data-theme',s);var f=null;try{f=localStorage.getItem('vigie24-font')}catch(e){}if(!f)f='100';document.documentElement.setAttribute('data-font',f)})();
    window.vigie24Theme={get:function(){return document.documentElement.getAttribute('data-theme')||'light'},set:function(t){document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('vigie24-theme',t)}catch(e){}}};
    window.vigie24Font={get:function(){return document.documentElement.getAttribute('data-font')||'100'},set:function(f){document.documentElement.setAttribute('data-font',f);try{localStorage.setItem('vigie24-font',f)}catch(e){}}};
    // Zen: cookie read server-side at prerender (no flash of anxiety-provoking articles); Secure on HTTPS
    window.vigie24Zen={set:function(on){var d=new Date();d.setTime(on?d.getTime()+365*24*3600*1000:0);var s=(location.protocol==='https:')?'; Secure':'';document.cookie='vigie24_zen='+(on?'1':'0')+'; path=/; expires='+d.toUTCString()+'; SameSite=Lax'+s}};
    </script>

    @* Données structurées JSON-LD (rich snippets Google) — WebSite + Organization globaux ;
       le BreadcrumbList est généré par page (CategoryArticles) via <HeadContent>. *@
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "Vigie24",
      "url": "https://vigie24.info/",
      "description": "Veille technologique francophone, ouverte sur l'actualité internationale : articles sélectionnés et analysés par IA.",
      "inLanguage": "fr"
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "Walby Developments",
      "url": "https://vigie24.info/",
      "logo": "https://vigie24.info/apple-touch-icon.png",
      "contactPoint": {
        "@@type": "ContactPoint",
        "email": "contact@vigie24.info",
        "contactType": "customer support",
        "availableLanguage": "French"
      }
    }
    </script>
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Une erreur s'est produite. Cette page ne sera pas actualisée jusqu'à ce que vous ayez redémarré l'application.
        </environment>
        <environment include="Development">
            Une erreur s'est produite. Actualisez cette page pour voir les détails.
        </environment>
        <a href="" class="reload">Actualiser</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="~/js/vigie24.min.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
