@page "/"
@namespace Vigie24.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components.Web
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // "Mode Radar" brand theme (petrol blue / teal / amber) — utilisé en staging ET en prod.
    // Les palettes haut contraste sont redéfinies dans ce bloc (après :root) pour ne pas être
    // écrasées par lui (même spécificité, ordre source).
    var isRadarBranding = string.Equals(Config["Branding:Theme"], "radar", StringComparison.OrdinalIgnoreCase);

    // La fiche article fournit ses propres og:type / og:image / twitter:image (image de l'article,
    // og:type=article) : on n'émet les valeurs génériques que sur les autres pages, pour éviter
    // des balises dupliquées que les crawlers interprètent mal.
    var requestPath = HttpContext.Request.Path.Value ?? "/";
    var isArticleDetail = requestPath.StartsWith("/articles/", StringComparison.OrdinalIgnoreCase)
        && Guid.TryParse(requestPath["/articles/".Length..].TrimEnd('/'), out _);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Le <title> et les meta par page sont fournis par <PageTitle>/<HeadContent> (rendus ici pendant le prerender).
       Dans une Razor Page, un composant se déclare via le tag helper <component> — ServerPrerendered pour
       qu'il soit présent dans le HTML initial ET hydraté pour les navigations SPA. *@
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <base href="~/" />
    <link rel="alternate" type="application/rss+xml" title="Vigie24 — Flux RSS complet" href="/feed" />
    @* Meta globaux invariants (Open Graph / Twitter). La description, le canonical et
       og:title/og:url sont fournis PAR PAGE via <HeadContent> (évite les doublons). *@
    <meta property="og:site_name" content="Vigie24" />
    <meta property="og:locale" content="fr_FR" />
    @if (!isArticleDetail)
    {
        <meta property="og:type" content="website" />
        <meta property="og:image" content="https://vigie24.info/og-image.png" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content="https://vigie24.info/og-image.png" />
    }
    @if (isRadarBranding)
    {
        <link rel="icon" type="image/x-icon" href="/favicon-radar.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-radar-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    }
    else
    {
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    }
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/a11y.min.css" asp-append-version="true" />
    @if (isRadarBranding)
    {
        @* ============================================================
           Charte graphique « Mode Radar » (specs originales) :
           bleu pétrole #1B4B5A · vert-sarcelle #5FB5A3/#EEF5F3 · ambre #E8A33D
           Inter (corps) · Space Grotesk (titres) · JetBrains Mono (données)
           ============================================================ *@
        <link rel="stylesheet" href="~/css/radar.min.css" asp-append-version="true" />
    }
    <script>
    // Anti-flash: theme/font from localStorage (else system preference) before first render
    (function(){var s=null;try{s=localStorage.getItem('vigie24-theme')}catch(e){}if(!s)s=(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches)?'dark':'light';document.documentElement.setAttribute('data-theme',s);var f=null;try{f=localStorage.getItem('vigie24-font')}catch(e){}if(!f)f='100';document.documentElement.setAttribute('data-font',f)})();
    window.vigie24Theme={get:function(){return document.documentElement.getAttribute('data-theme')||'light'},set:function(t){document.documentElement.setAttribute('data-theme',t);try{localStorage.setItem('vigie24-theme',t)}catch(e){}}};
    window.vigie24Font={get:function(){return document.documentElement.getAttribute('data-font')||'100'},set:function(f){document.documentElement.setAttribute('data-font',f);try{localStorage.setItem('vigie24-font',f)}catch(e){}}};
    // Zen: cookie read server-side at prerender (no flash of anxiety-provoking articles); Secure on HTTPS
    window.vigie24Zen={set:function(on){var d=new Date();d.setTime(on?d.getTime()+365*24*3600*1000:0);var s=(location.protocol==='https:')?'; Secure':'';document.cookie='vigie24_zen='+(on?'1':'0')+'; path=/; expires='+d.toUTCString()+'; SameSite=Lax'+s}};
    // Accessibilité: préférences du widget appliquées avant le premier rendu (aucun clignotement).
    (function(){var p=null;try{p=JSON.parse(localStorage.getItem('a11y.prefs')||'null')}catch(e){}if(!p||typeof p!=='object')return;
      var h=document.documentElement,S=['50','75','100','125','150'],T=['auto','light','dark','light-hc','dark-hc'];
      if(S.indexOf(p.size)>=0)h.setAttribute('data-font',p.size);
      if(T.indexOf(p.theme)>=0&&p.theme!=='auto')h.setAttribute('data-theme',p.theme);
      if(p.lh==='1'||p.lh==='2')h.classList.add('a11y-lh-'+p.lh);
      if(p.space==='1'||p.space==='2')h.classList.add('a11y-space-'+p.space);
      if(p.dys)h.classList.add('a11y-dys');
      if(p.noimg)h.classList.add('a11y-no-img');
      if(p.links)h.classList.add('a11y-links');
      if(p.cursor)h.classList.add('a11y-cursor');
      if(typeof p.sat==='number'&&p.sat<100)h.style.filter='saturate('+(Math.max(0,Math.min(100,p.sat))/100)+')';
      var rd=false;try{rd=window.matchMedia('(prefers-reduced-motion: reduce)').matches}catch(e){}
      if(p.nomotion||rd)h.classList.add('a11y-no-motion')})();
    </script>

    @* Données structurées JSON-LD (rich snippets Google) — WebSite + Organization globaux ;
       le BreadcrumbList est généré par page (CategoryArticles) via <HeadContent>. *@
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "name": "Vigie24",
      "url": "https://vigie24.info/",
      "description": "Veille technologique francophone, ouverte sur l'actualité internationale : articles sélectionnés et analysés par IA.",
      "inLanguage": "fr"
    }
    </script>
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "name": "Walby Developments",
      "url": "https://vigie24.info/",
      "logo": "https://vigie24.info/apple-touch-icon.png",
      "contactPoint": {
        "@@type": "ContactPoint",
        "email": "contact@vigie24.info",
        "contactType": "customer support",
        "availableLanguage": "French"
      }
    }
    </script>
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    @* ============================================================
       Widget d'accessibilité (hors arbre Blazor : aucun re-rendu ne l'écrase).
       Sans JavaScript, le bloc reste [hidden] et le site fonctionne normalement.
       ============================================================ *@
    <div data-a11y-root hidden>
        <button type="button" class="a11y-trigger" title="Réglages d'accessibilité" aria-haspopup="dialog" aria-controls="a11y-panel" aria-expanded="false">
            <svg class="a11y-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="4.2" r="2.1" fill="currentColor" />
                <path d="M4.2 8.4h15.6M12 8.9v5.6m0 0-3.4 6.9M12 14.5l3.4 6.9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span class="a11y-trigger-label">Accessibilité</span>
        </button>

        <dialog class="a11y-panel" id="a11y-panel" aria-labelledby="a11y-title">
            <div class="a11y-head">
                <h2 class="a11y-title" id="a11y-title">Accessibilité</h2>
                <button type="button" class="a11y-close a11y-x" aria-label="Fermer les réglages d'accessibilité">✕</button>
            </div>

            <div class="a11y-body">
                <fieldset class="a11y-group">
                    <legend>Taille du texte</legend>
                    <div class="a11y-seg">
                        <button type="button" data-a11y-set="size:50" aria-pressed="false">50 %</button>
                        <button type="button" data-a11y-set="size:75" aria-pressed="false">75 %</button>
                        <button type="button" data-a11y-set="size:100" aria-pressed="true">100 %</button>
                        <button type="button" data-a11y-set="size:125" aria-pressed="false">125 %</button>
                        <button type="button" data-a11y-set="size:150" aria-pressed="false">150 %</button>
                    </div>
                </fieldset>

                <fieldset class="a11y-group">
                    <legend>Thème et contraste</legend>
                    <div class="a11y-seg a11y-seg-2">
                        <button type="button" data-a11y-set="theme:auto" aria-pressed="true">Automatique</button>
                        <button type="button" data-a11y-set="theme:light" aria-pressed="false">Clair</button>
                        <button type="button" data-a11y-set="theme:dark" aria-pressed="false">Sombre</button>
                        <button type="button" data-a11y-set="theme:light-hc" aria-pressed="false">Clair renforcé</button>
                        <button type="button" data-a11y-set="theme:dark-hc" aria-pressed="false">Sombre renforcé</button>
                    </div>
                </fieldset>

                <fieldset class="a11y-group">
                    <legend>Hauteur de ligne</legend>
                    <div class="a11y-seg">
                        <button type="button" data-a11y-set="lh:0" aria-pressed="true">Site</button>
                        <button type="button" data-a11y-set="lh:1" aria-pressed="false">Aérée</button>
                        <button type="button" data-a11y-set="lh:2" aria-pressed="false">Très aérée</button>
                    </div>
                </fieldset>

                <fieldset class="a11y-group">
                    <legend>Espacement des textes</legend>
                    <div class="a11y-seg">
                        <button type="button" data-a11y-set="space:0" aria-pressed="true">Normal</button>
                        <button type="button" data-a11y-set="space:1" aria-pressed="false">Moyen</button>
                        <button type="button" data-a11y-set="space:2" aria-pressed="false">Large</button>
                    </div>
                </fieldset>

                <fieldset class="a11y-group">
                    <legend>Lecture et confort</legend>
                    <label class="a11y-switch">
                        <input type="checkbox" data-a11y-toggle="dys" />
                        <span class="a11y-switch-track" aria-hidden="true"></span>
                        <span class="a11y-switch-text">Mode dyslexie</span>
                    </label>
                    <label class="a11y-switch">
                        <input type="checkbox" data-a11y-toggle="noimg" />
                        <span class="a11y-switch-track" aria-hidden="true"></span>
                        <span class="a11y-switch-text">Masquer les images</span>
                    </label>
                    <label class="a11y-switch">
                        <input type="checkbox" data-a11y-toggle="links" />
                        <span class="a11y-switch-track" aria-hidden="true"></span>
                        <span class="a11y-switch-text">Liens soulignés</span>
                    </label>
                    <label class="a11y-switch">
                        <input type="checkbox" data-a11y-toggle="nomotion" />
                        <span class="a11y-switch-track" aria-hidden="true"></span>
                        <span class="a11y-switch-text">Réduire les animations</span>
                    </label>
                    <label class="a11y-switch">
                        <input type="checkbox" data-a11y-toggle="cursor" />
                        <span class="a11y-switch-track" aria-hidden="true"></span>
                        <span class="a11y-switch-text">Curseur agrandi</span>
                    </label>
                </fieldset>

                <fieldset class="a11y-group">
                    <legend>Saturation des couleurs</legend>
                    <div class="a11y-range">
                        <input type="range" min="0" max="100" step="10" value="100"
                               data-a11y-range="sat" aria-describedby="a11y-sat-hint" />
                        <output class="a11y-range-val">100 %</output>
                    </div>
                    <p class="a11y-hint" id="a11y-sat-hint">0 % rend le site entièrement en gris.</p>
                </fieldset>
            </div>

            <div class="a11y-foot">
                <button type="button" class="a11y-reset">Réinitialiser</button>
                <button type="button" class="a11y-close a11y-done">Fermer</button>
            </div>
            <p class="a11y-status" role="status" aria-live="polite"></p>
        </dialog>
    </div>


    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Une erreur s'est produite. Cette page ne sera pas actualisée jusqu'à ce que vous ayez redémarré l'application.
        </environment>
        <environment include="Development">
            Une erreur s'est produite. Actualisez cette page pour voir les détails.
        </environment>
        <a href="" class="reload">Actualiser</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="~/js/vigie24.min.js" asp-append-version="true"></script>
    <script src="~/js/a11y.min.js" asp-append-version="true" defer></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
