@page "/"
@namespace Vigie24.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components.Web
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    // "Mode Radar" brand theme (petrol blue / teal / amber) — utilisé en staging ET en prod.
    // Les palettes haut contraste sont redéfinies dans ce bloc (après :root) pour ne pas être
    // écrasées par lui (même spécificité, ordre source).
    var isRadarBranding = string.Equals(Config["Branding:Theme"], "radar", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Le <title> et les meta par page sont fournis par <PageTitle>/<HeadContent> (rendus ici pendant le prerender).
       Dans une Razor Page, un composant se déclare via le tag helper <component> — ServerPrerendered pour
       qu'il soit présent dans le HTML initial ET hydraté pour les navigations SPA. *@
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
    <base href="~/" />
    <link rel="alternate" type="application/rss+xml" title="Vigie24 — Flux RSS complet" href="/feed" />
    @* Meta globaux invariants (Open Graph / Twitter). La description, le canonical et
       og:title/og:url sont fournis PAR PAGE via <HeadContent> (évite les doublons). *@
    <meta property="og:site_name" content="Vigie24" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://vigie24.info/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://vigie24.info/og-image.png" />
    @if (isRadarBranding)
    {
        <link rel="icon" type="image/x-icon" href="/favicon-radar.ico" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-radar-32.png" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    }
    else
    {
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    }
    <style>
        /* ============================================================
           Thèmes : clair / sombre × contraste normal / élevé (WCAG AA/AAA)
           data-theme est posé sur <html> par le script anti-flash ci-dessous.
           ============================================================ */
        :root {
            --bg: #f4f6f9;
            --surface: #ffffff;
            --surface-alt: #f8fafc;
            --text: #1a1d21;
            --text-muted: #5b6472;
            --border: #d9dfe7;
            --border-strong: #9aa5b1;
            --accent: #1a5fb4;
            --accent-hover: #15529a;
            --accent-ink: #ffffff;
            --focus: #0b57d0;
            --nav-bg: #1e293b;
            --nav-ink: #cbd5e1;
            --nav-ink-hover: #ffffff;
            --brand-accent: #4ade80;
            --chip-cat-bg: #e0e7ff;
            --chip-cat-ink: #312e81;
            --chip-cat-border: #6366f1;
            --chip-tag-bg: transparent;
            --chip-tag-ink: #14532d;
            --chip-tag-border: #16a34a;
            --chip-sep: #64748b;
            --stance-pour: #16a34a;
            --stance-contre: #dc2626;
            --stance-nuance: #d97706;
            --stance-neutre: #64748b;
            --anxiety-low: #16a34a;
            --anxiety-med: #d97706;
            --anxiety-high: #dc2626;
            --vote-bad: #dc2626;
            --vote-good: #16a34a;
            --vote-ink: #ffffff;
            --success: #1a7f37;
            --alert-danger-bg: #f8d7da;
            --alert-danger-border: #f5c6cb;
            --alert-danger-ink: #7a1f1f;
            --alert-warning-bg: #fff3cd;
            --alert-warning-border: #e6c200;
            --alert-warning-ink: #664d03;
            --shadow: rgba(15, 23, 42, 0.10);
            --code-bg: #0f172a;
            --code-ink: #e2e8f0;
        }

        [data-theme="dark"] {
            --bg: #0f172a;
            --surface: #1e293b;
            --surface-alt: #16213a;
            --text: #e2e8f0;
            --text-muted: #a8b3c4;
            --border: #334155;
            --border-strong: #64748b;
            --accent: #60a5fa;
            --accent-hover: #7cb4fb;
            --accent-ink: #0f172a;
            --focus: #93c5fd;
            --nav-bg: #020617;
            --nav-ink: #cbd5e1;
            --nav-ink-hover: #ffffff;
            --brand-accent: #4ade80;
            --chip-cat-bg: #312e81;
            --chip-cat-ink: #c7d2fe;
            --chip-cat-border: #818cf8;
            --chip-tag-bg: transparent;
            --chip-tag-ink: #bbf7d0;
            --chip-tag-border: #4ade80;
            --chip-sep: #94a3b8;
            --stance-pour: #4ade80;
            --stance-contre: #f87171;
            --stance-nuance: #fbbf24;
            --stance-neutre: #94a3b8;
            --anxiety-low: #4ade80;
            --anxiety-med: #fbbf24;
            --anxiety-high: #f87171;
            --vote-bad: #f87171;
            --vote-good: #4ade80;
            --vote-ink: #0f172a;
            --success: #4ade80;
            --alert-danger-bg: #450a0a;
            --alert-danger-border: #dc2626;
            --alert-danger-ink: #fecaca;
            --alert-warning-bg: #422006;
            --alert-warning-border: #a16207;
            --alert-warning-ink: #fde68a;
            --shadow: rgba(0, 0, 0, 0.45);
            --code-bg: #0b1120;
            --code-ink: #e2e8f0;
        }

        /* Haut contraste clair : noir sur blanc, bordures marquées, liens soulignés */
        [data-theme="light-hc"] {
            --bg: #ffffff;
            --surface: #ffffff;
            --surface-alt: #ffffff;
            --text: #000000;
            --text-muted: #000000;
            --border: #000000;
            --border-strong: #000000;
            --accent: #0047ab;
            --accent-hover: #00337a;
            --accent-ink: #ffffff;
            --focus: #000000;
            --nav-bg: #000000;
            --nav-ink: #ffffff;
            --nav-ink-hover: #ffffff;
            --brand-accent: #ffff00;
            --chip-cat-bg: #e0e7ff;
            --chip-cat-ink: #000000;
            --chip-cat-border: #000000;
            --chip-tag-bg: #ffffff;
            --chip-tag-ink: #000000;
            --chip-tag-border: #000000;
            --chip-sep: #000000;
            --vote-bad: #8b0000;
            --vote-good: #006400;
            --vote-ink: #ffffff;
            --success: #006400;
            --alert-danger-bg: #ffffff;
            --alert-danger-border: #000000;
            --alert-danger-ink: #8b0000;
            --alert-warning-bg: #ffffff;
            --alert-warning-border: #000000;
            --alert-warning-ink: #5c3d00;
            --shadow: none;
            --code-bg: #ffffff;
            --code-ink: #000000;
        }

        /* Haut contraste sombre : blanc sur noir, liens jaunes soulignés */
        [data-theme="dark-hc"] {
            --bg: #000000;
            --surface: #000000;
            --surface-alt: #000000;
            --text: #ffffff;
            --text-muted: #ffffff;
            --border: #ffffff;
            --border-strong: #ffffff;
            --accent: #ffd400;
            --accent-hover: #ffe14d;
            --accent-ink: #000000;
            --focus: #ffd400;
            --nav-bg: #000000;
            --nav-ink: #ffffff;
            --nav-ink-hover: #ffffff;
            --brand-accent: #ffff00;
            --chip-cat-bg: #ffd400;
            --chip-cat-ink: #000000;
            --chip-cat-border: #000000;
            --chip-tag-bg: #000000;
            --chip-tag-ink: #ffffff;
            --chip-tag-border: #ffffff;
            --chip-sep: #ffffff;
            --vote-bad: #ff6b6b;
            --vote-good: #6bff6b;
            --vote-ink: #000000;
            --success: #6bff6b;
            --alert-danger-bg: #000000;
            --alert-danger-border: #ffffff;
            --alert-danger-ink: #ff6b6b;
            --alert-warning-bg: #000000;
            --alert-warning-border: #ffffff;
            --alert-warning-ink: #ffd400;
            --shadow: none;
            --code-bg: #000000;
            --code-ink: #ffffff;
        }

        /* ===== Accessibilité générale ===== */
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; font-size: 100%; }
        html[data-font="50"] { font-size: 50%; }
        html[data-font="75"] { font-size: 75%; }
        html[data-font="125"] { font-size: 125%; }
        html[data-font="150"] { font-size: 150%; }
        body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); }
        :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
        a { color: var(--accent); }
        [data-theme$="-hc"] a { text-decoration: underline; }
        .skip-link {
            position: absolute; left: -9999px; top: 0; z-index: 2000;
            background: var(--accent); color: var(--accent-ink); padding: 10px 16px;
            border-radius: 0 0 8px 0; font-weight: 700; text-decoration: none;
        }
        .skip-link:focus { left: 0; }
        .page { display: flex; flex-direction: column; min-height: 100vh; }
        main { flex: 1; padding: 24px; max-width: 1400px; margin: 0 auto; width: 100%; }
        h1 { color: var(--text); font-size: 1.7rem; }
        h2 { font-size: 1.3rem; color: var(--text); }
        .text-success { color: var(--success); font-weight: 600; }
        .text-warning { color: var(--warning); font-weight: 600; }
        .text-danger { color: var(--danger); font-weight: 600; }
        .muted { color: var(--text-muted); font-size: 0.85rem; }

        /* ===== Barre de navigation ===== */
        .topnav { display: flex; align-items: center; gap: 6px; background: var(--nav-bg); padding: 0 20px; flex-wrap: wrap; position: relative; }
        .topnav .brand { color: #fff; font-weight: 700; font-size: 1.1rem; padding: 10px 12px 10px 0; text-decoration: none; margin-right: 10px; display: inline-flex; align-items: center; gap: 9px; }
        .topnav .brand .brand-logo { border-radius: 6px; display: block; }
        .topnav .brand .brand-text { display: inline-flex; align-items: baseline; }
        .topnav .brand .brand-text span { color: var(--brand-accent); }
        .topnav a.nav { color: var(--nav-ink); text-decoration: none; padding: 14px 14px; border-bottom: 3px solid transparent; }
        .topnav a.nav:hover { color: var(--nav-ink-hover); }
        .topnav a.nav.active { color: var(--nav-ink-hover); border-bottom-color: var(--brand-accent); }

        /* Menu hamburger (affiché en mobile uniquement) */
        .nav-toggle {
            display: none; flex-direction: column; justify-content: center; gap: 5px;
            background: none; border: 1px solid var(--nav-ink); border-radius: 8px;
            padding: 8px 9px; cursor: pointer;
        }
        .nav-toggle .bar { display: block; width: 22px; height: 2px; background: var(--nav-ink-hover); border-radius: 1px; }
        .nav-toggle:hover { border-color: var(--brand-accent); }
        .nav-links { display: flex; align-items: center; }

        @@media (max-width: 860px) {
            .nav-toggle { display: flex; }
            .nav-links {
                display: none;
                position: absolute; top: 100%; left: 0; right: 0;
                flex-direction: column; align-items: stretch;
                background: var(--nav-bg); border-top: 1px solid var(--border);
                box-shadow: 0 8px 16px var(--shadow); z-index: 500;
            }
            .nav-links.open { display: flex; }
            .nav-links a.nav { padding: 14px 20px; }
            .nav-links a.nav.active { border-bottom: 3px solid var(--brand-accent); }
        }

        .topnav-right { margin-left: auto; display: flex; gap: 8px; align-items: center; }
        .theme-switcher { display: flex; align-items: center; }
        .theme-switcher select, .font-switcher select {
            background: var(--nav-bg); color: var(--nav-ink-hover); border: 1px solid var(--nav-ink);
            border-radius: 8px; padding: 7px 10px; font-size: 0.85rem; cursor: pointer;
        }
        .theme-switcher select:hover, .font-switcher select:hover { border-color: var(--brand-accent); }

        /* Mode zen global (nav) + bandeau d'état */
        .zen-toggle {
            background: var(--nav-bg); color: var(--nav-ink-hover);
            border: 1px solid var(--nav-ink); border-radius: 999px;
            padding: 7px 12px; font-size: 0.85rem; cursor: pointer; font-weight: 600;
            display: inline-flex; align-items: center; gap: 4px;
        }
        .zen-toggle:hover { border-color: var(--brand-accent); }
        .zen-toggle.zen-on {
            background: color-mix(in srgb, var(--anxiety-low) 22%, var(--nav-bg));
            border-color: var(--anxiety-low); color: #fff;
        }
        .zen-banner {
            background: color-mix(in srgb, var(--anxiety-low) 12%, var(--surface));
            border: 1px solid var(--anxiety-low); border-radius: 8px;
            padding: 10px 14px; margin: 12px 0 4px; font-size: 0.9rem;
        }
        .zen-banner strong { color: var(--anxiety-low); }

        /* ===== Barre secondaire « bibliothèque » (contenu) ===== */
        .subnav {
            display: flex; align-items: center; gap: 2px;
            background: var(--surface); border-bottom: 1px solid var(--border);
            padding: 0 20px; overflow-x: auto; white-space: nowrap;
        }
        .subnav-link {
            color: var(--text-muted); text-decoration: none; font-size: 0.86rem; font-weight: 600;
            padding: 9px 11px; border-bottom: 2px solid transparent; display: inline-block; flex: none;
        }
        .subnav-link:hover { color: var(--text); }
        .subnav-link.active { color: var(--accent); border-bottom-color: var(--accent); }
        .subnav-spacer { flex: 1; }
        .subnav-feed { font-size: 0.8rem; }
        [data-theme$="-hc"] .subnav { border-bottom-width: 2px; }
        [data-theme$="-hc"] .subnav-link.active { text-decoration: underline; }

        /* Mobile : 4 prioritaires + bouton « ⋯ Plus » + panneau (zéro défilement) */
        .subnav-more {
            display: none; border: none; background: none; cursor: pointer;
            color: var(--accent); font-weight: 700; font-size: 0.86rem;
            padding: 9px 8px 9px 14px; margin-left: auto; flex: none;
        }
        .subnav-panel { display: none; }

        @@media (max-width: 720px) {
            .subnav { overflow-x: visible; flex-wrap: wrap; padding: 2px 12px; }
            .subnav-link { padding: 8px 9px; font-size: 0.82rem; }
            .subnav-more-link { display: none; }
            .subnav-more { display: inline-block; }
            .subnav-panel {
                display: block; background: var(--surface);
                border-bottom: 1px solid var(--border);
                padding: 6px 12px 10px;
            }
            .subnav-panel-link {
                display: block; padding: 9px 8px; color: var(--text);
                text-decoration: none; font-weight: 600; font-size: 0.92rem;
                border-top: 1px dashed var(--border-strong);
            }
            .subnav-panel-link:hover { color: var(--accent); }
            .subnav-panel-link.active { color: var(--accent); }
        }

        /* ===== Alertes / statut ===== */
        .alert { padding: 12px 16px; margin: 16px 0; border-radius: 6px; border: 1px solid transparent; }
        .alert-danger { background-color: var(--alert-danger-bg); border-color: var(--alert-danger-border); color: var(--alert-danger-ink); }
        .alert-warning { background-color: var(--alert-warning-bg); border-color: var(--alert-warning-border); color: var(--alert-warning-ink); }
        .status-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin: 16px 0; }

        /* ===== Page Coûts IA ===== */
        .period-switch { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0; }
        .period-btn {
            border: 1.5px solid var(--border-strong); background: var(--surface); color: var(--text);
            border-radius: 999px; padding: 7px 16px; font-size: 0.85rem; cursor: pointer; font-weight: 600;
        }
        .period-btn:hover { border-color: var(--accent); color: var(--accent); }
        .period-btn.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin: 16px 0; }
        .stat-card {
            background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
            padding: 14px; display: flex; flex-direction: column; gap: 4px;
        }
        .stat-label { font-size: 0.75rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .stat-value { font-size: 1.15rem; font-weight: 700; font-family: 'JetBrains Mono', ui-monospace, monospace; }
        .chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px; margin: 16px 0; }
        .chart-card h2 { margin: 0 0 10px; font-size: 1.05rem; }
        .cost-chart { width: 100%; height: auto; }
        .chart-bar { fill: var(--accent); }
        .cost-chart.chf .chart-bar { fill: var(--brand-accent); }
        .chart-axis { stroke: var(--border-strong); stroke-width: 1; }
        .chart-max { font-size: 11px; fill: var(--text-muted); font-family: 'JetBrains Mono', ui-monospace, monospace; }
        .chart-label { font-size: 10px; fill: var(--text-muted); }
        .chart-note { font-size: 0.8rem; margin: 6px 0 0; }
        [data-theme$="-hc"] .period-btn, [data-theme$="-hc"] .stat-card, [data-theme$="-hc"] .chart-card { border-width: 2px; }

        /* ===== Page Projet : score en détail ===== */
        .score-formula {
            background: var(--surface-alt); border: 1px solid var(--border); border-radius: 8px;
            padding: 10px 14px; font-family: 'JetBrains Mono', ui-monospace, monospace;
        }
        .score-table { border-collapse: collapse; margin: 10px 0; width: 100%; max-width: 520px; }
        .score-table th, .score-table td {
            border: 1px solid var(--border); padding: 6px 12px; text-align: left; font-size: 0.9rem;
        }
        .score-table th { background: var(--surface-alt); font-weight: 700; }
        .license-card h3 { margin: 18px 0 6px; font-size: 1rem; }

        /* ===== Page Charte graphique : palette ===== */
        .palette-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; margin: 10px 0; }
        .palette-item {
            display: flex; flex-direction: column; gap: 3px; background: var(--surface);
            border: 1px solid var(--border); border-radius: 8px; padding: 10px;
        }
        .palette-item code { font-size: 0.78rem; }
        .swatch { width: 100%; height: 34px; border-radius: 6px; margin-bottom: 4px; }

        /* ===== Chips (catégories / thèmes) ===== */
        /* Distinction accessible : la catégorie est une puce PLEINE (fond teinté + bordure
           soutenue, coins carrés, icône 🗂) ; la thématique une puce CONTOUR (fond neutre,
           bordure teintée, pill, icône 🏷). Couleur + remplissage + icône = 3 indices
           redondants (daltonisme, basse vision). Contrastes : texte ≥ 4.5:1, bordures ≥ 3:1. */
        .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
        .chip { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.78rem; text-decoration: none; white-space: nowrap; }
        .chip-cat {
            background: var(--chip-cat-bg); color: var(--chip-cat-ink);
            border: 1.5px solid var(--chip-cat-border);
            border-radius: 6px; font-weight: 600;
        }
        .chip-cat:hover { filter: brightness(0.94); }
        .chip-tag {
            background: var(--chip-tag-bg); color: var(--chip-tag-ink);
            border: 1.5px solid var(--chip-tag-border);
            border-radius: 999px;
        }
        .chip-tag:hover { filter: brightness(0.94); }
        .chip-sep { color: var(--chip-sep); }
        .chip-icon { margin-right: 3px; }
        /* Les informations atomiques (nombre + unité/icône) ne doivent jamais se couper :
           retour à la ligne entre unités, jamais à l'intérieur. */
        .nowrap { white-space: nowrap; }
        .debate-camp h3 { white-space: nowrap; }
        /* Badge de position (débats) : fond teinté + bordure teintée + icône — contraste texte ≥ 4.5:1
           (encre = 55 % teinte + 45 % texte), bordure ≥ 3:1. La teinte suit le thème (variable --c locale). */
        .chip-stance {
            background: color-mix(in srgb, var(--c) 16%, var(--surface));
            color: color-mix(in srgb, var(--c) 55%, var(--text));
            border: 1.5px solid var(--c);
            border-radius: 6px; font-weight: 600;
        }
        .chip-stance-pour { --c: var(--stance-pour); }
        .chip-stance-contre { --c: var(--stance-contre); }
        .chip-stance-nuance { --c: var(--stance-nuance); }
        .chip-stance-neutre { --c: var(--stance-neutre); }
        [data-theme$="-hc"] .chip-stance { color: var(--text); background: var(--surface); }
        /* Badge anxiété : même pattern color-mix que les positions de débat (3 paliers) */
        .chip-anxiety {
            background: color-mix(in srgb, var(--c) 16%, var(--surface));
            color: color-mix(in srgb, var(--c) 55%, var(--text));
            border: 1.5px solid var(--c);
            border-radius: 6px; font-weight: 600;
        }
        .chip-anxiety-low  { --c: var(--anxiety-low); }
        .chip-anxiety-med  { --c: var(--anxiety-med); }
        .chip-anxiety-high { --c: var(--anxiety-high); }
        [data-theme$="-hc"] .chip-anxiety { color: var(--text); background: var(--surface); }

        /* ===== Timeline ===== */
        .timeline { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 14px 0; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px; }
        .tl-pill { border: 1px solid var(--border-strong); background: var(--surface); color: var(--text); border-radius: 16px; padding: 5px 12px; font-size: 0.82rem; cursor: pointer; }
        .tl-pill:hover { border-color: var(--accent); color: var(--accent); }
        .tl-pill.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
        .tl-pill .count { opacity: 0.85; font-size: 0.75rem; }
        .tl-custom { display: flex; gap: 6px; align-items: center; margin-left: auto; }
        .tl-custom input[type=date] { border: 1px solid var(--border-strong); border-radius: 6px; padding: 4px 8px; font-size: 0.82rem; background: var(--surface); color: var(--text); }

        /* ===== Barre de filtres (recherche / tri / pays / pagination) ===== */
        .browser-toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 14px 0 0; }
        .browser-toolbar input[type=search], .browser-toolbar input.search-input {
            flex: 1 1 240px; min-width: 180px;
            border: 1px solid var(--border-strong); border-radius: 20px; padding: 8px 16px; font-size: 0.9rem;
            background: var(--surface); color: var(--text);
        }
        .browser-toolbar select, .advanced-filters select {
            border: 1px solid var(--border-strong); border-radius: 8px; padding: 8px 10px; font-size: 0.9rem;
            background: var(--surface); color: var(--text);
        }
        /* Réglette d'anxiété (barre d'outils principale, version compacte) */
        .toolbar-slider { display: flex; align-items: center; gap: 8px; }
        .toolbar-slider label { font-size: 0.85rem; color: var(--text); white-space: nowrap; }
        .toolbar-slider input[type=range] { width: 110px; accent-color: var(--accent); }
        .result-count { font-size: 0.85rem; color: var(--text-muted); margin-left: auto; white-space: nowrap; }

        /* ===== Filtres avancés ===== */
        .btn-toggle {
            border: 1px solid var(--border-strong); background: var(--surface); color: var(--text);
            border-radius: 8px; padding: 8px 12px; font-size: 0.85rem; cursor: pointer; font-weight: 600;
        }
        .btn-toggle:hover { border-color: var(--accent); color: var(--accent); }
        .btn-toggle.open { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
        .advanced-filters {
            display: flex; flex-wrap: wrap; gap: 18px; margin: 10px 0 0; padding: 14px;
            background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
        }
        .advanced-filters .af-group { display: flex; flex-direction: column; gap: 6px; min-width: 220px; flex: 1 1 240px; }
        .advanced-filters .af-group label { font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .advanced-filters .af-chips { display: flex; flex-wrap: wrap; gap: 6px; }
        .advanced-filters .af-chip {
            border: 1px solid var(--border-strong); background: var(--surface); color: var(--text);
            border-radius: 14px; padding: 4px 12px; font-size: 0.82rem; cursor: pointer;
        }
        .advanced-filters .af-chip.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }
        .advanced-filters .af-range { display: flex; align-items: center; gap: 10px; }
        .advanced-filters input[type=range] { flex: 1; accent-color: var(--accent); }
        .advanced-filters .af-value { font-weight: 700; min-width: 3ch; }
        .advanced-filters .af-reset {
            align-self: flex-end; border: 1px solid var(--vote-bad); background: var(--surface); color: var(--vote-bad);
            border-radius: 8px; padding: 7px 14px; font-size: 0.85rem; cursor: pointer; font-weight: 600;
        }
        .advanced-filters .af-reset:hover { background: var(--vote-bad); color: var(--vote-ink); }
        .advanced-filters .af-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
        .advanced-filters .af-note { font-size: 0.8rem; margin-top: 6px; }
        .advanced-filters .af-copied { font-size: 0.8rem; font-weight: 600; }

        /* ===== Cartes articles ===== */
        .article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 20px; margin-top: 8px; }
        .article-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
        .article-card:hover { box-shadow: 0 4px 12px var(--shadow); }
        .card-img-link { display: block; }
        .card-img { width: 100%; height: 180px; object-fit: cover; display: block; }
        .card-img-placeholder { display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.92); font-size: 3rem; font-weight: 700; position: relative; }
        .card-img-placeholder .card-img-initial { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: 700; opacity: 0.55; }
        .card-img-placeholder .card-img-favicon { position: relative; z-index: 1; width: 56px; height: 56px; object-fit: contain; border-radius: 12px; background: rgba(255,255,255,0.20); padding: 8px; }
        .card-body { padding: 14px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
        .card-title { margin: 0; font-size: 1.05rem; line-height: 1.35; }
        .card-title a { color: var(--text); text-decoration: none; }
        .card-title a:hover { color: var(--accent); }
        .reader-link { display: inline-block; font-size: 0.8rem; color: var(--accent); text-decoration: none; font-weight: 600; margin: 2px 0 4px; }
        .reader-link:hover { text-decoration: underline; }
        .card-text { margin: 0; color: var(--text-muted); font-size: 0.9rem; }
        .authors { margin: 0; color: var(--text-muted); font-size: 0.85rem; }
        .meta { margin: 0; display: flex; justify-content: space-between; align-items: center; font-size: 0.83rem; color: var(--text-muted); }
        .country { display: inline-flex; align-items: center; gap: 4px; }

        /* ===== Engagement : vote 0-5 + clics ===== */
        .vote-row { display: flex; align-items: center; gap: 4px; margin-top: 2px; flex-wrap: wrap; }
        .vote-label { font-size: 0.78rem; color: var(--text-muted); margin-right: 2px; }
        .vote-btn { width: 26px; height: 26px; border: 1px solid var(--border-strong); border-radius: 6px; background: var(--surface); color: var(--text); font-size: 0.8rem; cursor: pointer; padding: 0; line-height: 1; transition: all 0.12s; }
        .vote-btn:hover { border-color: var(--accent); color: var(--accent); }
        .vote-btn.active { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); font-weight: 700; }
        .vote-btn.vote-bad.active { background: var(--vote-bad); border-color: var(--vote-bad); color: var(--vote-ink); }
        .vote-btn.vote-good.active { background: var(--vote-good); border-color: var(--vote-good); color: var(--vote-ink); }
        .vote-stats { font-size: 0.8rem; color: var(--text); font-weight: 600; margin-left: 6px; }
        .click-stats { font-size: 0.8rem; color: var(--text-muted); }
        .eng-stats { display: flex; gap: 10px; align-items: center; margin-left: auto; }

        /* ===== Hint de score (calcul précis) ===== */
        .score-hint { position: relative; }
        .score { cursor: help; }
        [data-theme$="-hc"] .score { text-decoration: underline; }
        .hint-popup { position: absolute; right: 0; bottom: 100%; margin-bottom: 6px; background: var(--code-bg); color: var(--code-ink); font-size: 0.78rem; line-height: 1.5; padding: 10px 12px; border-radius: 6px; white-space: pre-line; width: 300px; z-index: 10; box-shadow: 0 4px 14px var(--shadow); }
        .hint-popup::after { content: ""; position: absolute; top: 100%; right: 18px; border: 6px solid transparent; border-top-color: var(--code-bg); }

        /* ===== Arborescence catégories ===== */
        .tree { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 10px; }
        .tree-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px; }
        /* Accent ambre : renforce l'identité « catégorie = ambre » (déclarée après la règle de base) */
        .tree-card { border-left: 4px solid var(--chip-cat-border); }
        .tree-card h3 { margin: 0 0 8px; font-size: 1.05rem; }
        .tree-card h3 a { color: var(--text); text-decoration: none; }
        .tree-card h3 a:hover { color: var(--accent); }
        .tree-sub { display: flex; justify-content: space-between; padding: 5px 0; border-top: 1px solid var(--border); font-size: 0.9rem; }
        .tree-sub a { color: var(--text); text-decoration: none; }
        .tree-sub a:hover { color: var(--accent); }
        /* Catégorie vide : atténuée mais conservée dans l'arbre (la taxonomie reste visible) */
        .tree-sub.is-empty { opacity: 0.55; }
        .tree-sub.is-empty .count-badge { background: transparent; color: var(--text-muted); }
        .count-badge { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 10px; padding: 1px 8px; font-size: 0.75rem; color: var(--text); }

        /* ===== Divers ===== */
        .breadcrumb { margin: 8px 0 4px; color: var(--text-muted); font-size: 0.9rem; }
        .breadcrumb a { color: var(--accent); text-decoration: none; }
        .page-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; }
        .page-head .muted { font-size: 0.9rem; }

        /* ===== Mode lecture (fiche article /articles/{id}) ===== */
        .reader { max-width: 72ch; margin: 0 auto; padding: 8px 0 40px; }
        .reader-img { width: 100%; max-height: 380px; object-fit: cover; border-radius: 10px; margin-bottom: 16px; }
        .reader h1 { font-size: 1.9rem; line-height: 1.25; margin: 0 0 10px; }
        .reader .reader-meta { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; color: var(--text-muted); font-size: 0.9rem; margin: 10px 0 22px; }
        .reader .reader-meta a { color: var(--accent); text-decoration: none; }
        .reader .reader-meta a:hover { text-decoration: underline; }
        .reader .score { cursor: help; }
        .reader-body { font-size: 1.08rem; line-height: 1.75; color: var(--text); white-space: pre-line; }
        .reader-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
        .reader-actions .chip { font-size: 0.9rem; padding: 8px 16px; }

        /* ===== Annexe « Réflexion & analyse » (fiche article) ===== */
        .reader-analysis {
            margin-top: 24px; padding: 12px 16px;
            background: var(--surface-alt); border: 1px solid var(--border);
            border-radius: 8px; font-size: 0.92rem;
        }
        .reader-analysis > summary {
            cursor: pointer; font-weight: 600; color: var(--text);
            user-select: none; list-style-position: outside;
        }
        .reader-analysis > summary:hover { color: var(--accent); }
        .analysis-justification { margin: 10px 0 6px; line-height: 1.6; }
        .analysis-dl {
            display: grid; grid-template-columns: max-content 1fr;
            gap: 4px 16px; margin: 8px 0 4px;
        }
        .analysis-dl dt {
            color: var(--text-muted); font-size: 0.78rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.04em; padding-top: 2px;
        }
        .analysis-dl dd { margin: 0; }
        .analysis-reasoning {
            margin-top: 10px; padding: 10px 12px;
            border: 1px dashed var(--border-strong); border-radius: 6px;
        }
        .analysis-reasoning summary { cursor: pointer; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; }
        .analysis-reasoning p {
            margin: 8px 0 0; white-space: pre-line;
            font-size: 0.85rem; line-height: 1.55; color: var(--text-muted);
        }
        [data-theme$="-hc"] .reader-analysis { border-width: 2px; }
        [data-theme$="-hc"] .analysis-reasoning { border-width: 2px; }

        /* ===== Journal du rédacteur IA ===== */
        .journal-entry {
            background: var(--surface); border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            border-radius: 8px; padding: 12px 16px; margin: 10px 0;
        }
        .journal-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .journal-head a { color: var(--text); text-decoration: none; font-weight: 600; }
        .journal-head a:hover { color: var(--accent); text-decoration: underline; }
        .journal-justif { margin: 8px 0 4px; line-height: 1.6; font-size: 0.95rem; }
        .journal-meta { margin: 0; font-size: 0.8rem; }
        .chip-refused {
            background: var(--alert-danger-bg); color: var(--alert-danger-ink);
            border: 1px solid var(--alert-danger-border); border-radius: 6px; font-weight: 600;
        }
        [data-theme$="-hc"] .journal-entry { border-width: 2px; }

        /* ===== Accueil : hero + couches (maçonnerie) ===== */
        .home-hero { margin: 8px 0 4px; }
        .home-hero h1 { font-size: 2.6rem; margin-bottom: 6px; letter-spacing: -0.02em; }
        .home-tagline { font-size: 1.08rem; line-height: 1.75; max-width: 72ch; color: var(--text); }
        .stats-strip { display: flex; flex-wrap: wrap; gap: 10px; margin: 14px 0 4px; }
        .stat-pill {
            background: var(--surface); border: 1px solid var(--border); border-radius: 999px;
            padding: 7px 16px; font-size: 0.92rem; color: var(--text-muted);
        }
        .stat-pill strong { color: var(--text); font-size: 1.05rem; }

        .home-section-title {
            font-size: 1.5rem; margin: 26px 0 14px; padding-bottom: 10px;
            border-bottom: 2px solid var(--border-strong);
        }

        /* Maçonnerie : multi-colonnes CSS (1 sur mobile, 2 sur écran large), cartes de hauteurs variées */
        .home-layers { columns: 1; column-gap: 20px; margin: 0 0 10px; }
        .layer-card {
            break-inside: avoid; margin-bottom: 20px;
            background: var(--surface); border: 1px solid var(--border);
            border-top: 3px solid var(--accent); border-radius: 10px;
            padding: 16px 20px 14px;
        }
        .layer-head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
        .layer-icon { font-size: 1.55rem; line-height: 1; }
        .layer-title { margin: 0; font-size: 1.35rem; letter-spacing: -0.01em; flex: 1; }
        .layer-title a { color: var(--text); text-decoration: none; }
        .layer-title a:hover { color: var(--accent); text-decoration: underline; }
        .layer-cta { font-weight: 700; font-size: 0.88rem; white-space: nowrap; }
        .layer-desc { margin: 8px 0 10px; font-size: 0.95rem; line-height: 1.6; }
        .layer-items { list-style: none; margin: 0; padding: 0; }
        .layer-items li { display: flex; gap: 10px; align-items: center; padding: 8px 0; border-top: 1px dashed var(--border-strong); font-size: 0.97rem; }
        .layer-items a { color: var(--text); text-decoration: none; font-weight: 600; }
        .layer-items a:hover { color: var(--accent); text-decoration: underline; }
        .layer-item-main { flex: 1; min-width: 0; }
        .layer-item-main .layer-excerpt { display: block; }
        .layer-excerpt { color: var(--text-muted); font-size: 0.88rem; font-weight: 400; }

        /* Vignette d'article (image du flux ou dégradé + initiale) */
        .layer-thumb { width: 46px; height: 46px; border-radius: 8px; overflow: hidden; flex: none; }
        .layer-thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .layer-thumb-fallback {
            width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
            color: rgba(255, 255, 255, 0.92); font-weight: 700; font-size: 1.15rem;
        }

        /* Parcourir Vigie24 : navigation groupée */
        .layer-nav-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 18px; margin-top: 6px; }
        .layer-nav-col h3 {
            margin: 0 0 6px; font-size: 0.78rem; font-weight: 700; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.05em;
        }
        .layer-nav-col a {
            display: block; padding: 7px 0; border-top: 1px dashed var(--border-strong);
            color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.95rem;
        }
        .layer-nav-col a:hover { color: var(--accent); text-decoration: underline; }
        .layer-nav-col a .muted { font-weight: 400; }
        .layer-chips { margin-top: 6px; }

        .home-articles-head { margin-top: 26px; }
        .home-articles-head h2 { font-size: 1.5rem; margin: 0; }
        .home-articles-more { text-align: center; margin: 16px 0 4px; }
        .home-articles-more .chip { font-size: 0.95rem; padding: 8px 18px; }

        @@media (min-width: 920px) {
            .home-layers { columns: 2; }
        }

        /* ===== Page Projet : partie « tout public » ===== */
        .project-lead { font-size: 1.08rem; line-height: 1.75; max-width: 78ch; }
        .project-steps { margin: 8px 0 0; padding-left: 22px; line-height: 1.7; }
        .project-steps li { margin: 8px 0; }
        .project-section-title {
            font-size: 1.5rem; margin: 26px 0 14px; padding-bottom: 10px;
            border-bottom: 2px solid var(--border-strong);
        }
        .project-strengths { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 14px; margin: 0 0 10px; }
        .project-strength { margin-bottom: 0; }
        .project-note { font-size: 0.92rem; margin: 16px 0 4px; max-width: 78ch; }

        /* Séparation forte : bande sombre entre la partie publique et la partie technique */
        .project-tech-divider {
            margin: 36px 0 28px; padding: 26px 24px; border-radius: 14px;
            background: var(--nav-bg); color: var(--nav-ink);
            border: 2px solid var(--border-strong);
            display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px;
        }
        .project-tech-divider-label { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.01em; }
        .project-tech-divider-sub { font-size: 0.92rem; color: var(--nav-ink-hover); }
        [data-theme$="-hc"] .project-tech-divider { border-width: 3px; }

        /* ===== Baromètre de l'anxiété ===== */
        /* Bandeau accueil : reprend la forme du bandeau débats, teinte selon le niveau */
        .barometer-banner { --c: var(--anxiety-med); border-color: var(--c); }
        .barometer-banner.chip-anxiety-low { --c: var(--anxiety-low); }
        .barometer-banner.chip-anxiety-med { --c: var(--anxiety-med); }
        .barometer-banner.chip-anxiety-high { --c: var(--anxiety-high); }
        .barometer-banner .debate-banner-text strong { color: var(--c); }
        .barometer-banner .debate-banner-cta { color: var(--c); }

        .barometer-hero {
            --c: var(--anxiety-med);
            display: flex; align-items: center; gap: 24px; flex-wrap: wrap;
            background: color-mix(in srgb, var(--c) 10%, var(--surface));
            border: 1px solid var(--c); border-radius: 12px;
            padding: 20px 24px; margin: 16px 0;
        }
        .barometer-main { flex: 1; min-width: 180px; }
        .barometer-value {
            font-size: 3rem; font-weight: 800; line-height: 1;
            font-family: 'JetBrains Mono', ui-monospace, monospace; color: var(--c);
        }
        .barometer-unit { font-size: 1.2rem; font-weight: 600; color: var(--text-muted); margin-left: 4px; }
        .barometer-side { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
        .barometer-delta { font-weight: 700; font-size: 0.95rem; }
        .barometer-delta.delta-up { color: var(--anxiety-high); }
        .barometer-delta.delta-down { color: var(--anxiety-low); }
        .barometer-chart { width: 100%; height: auto; }
        .barometer-ref { stroke-width: 1; stroke-dasharray: 4 4; }
        .barometer-ref-low { stroke: var(--anxiety-low); opacity: 0.55; }
        .barometer-ref-high { stroke: var(--anxiety-med); opacity: 0.55; }
        .barometer-dot { fill: var(--accent); }
        .barometer-legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 0.82rem; color: var(--text-muted); margin: 6px 0 4px; }
        .barometer-legend i { display: inline-block; }
        .legend-line { width: 22px; height: 3px; border-radius: 2px; vertical-align: middle; background: var(--lc, var(--border-strong)); margin-right: 5px; }
        .legend-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); vertical-align: middle; margin-right: 5px; }
        .barometer-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin: 18px 0; }
        .barometer-row { display: flex; align-items: center; gap: 10px; padding: 5px 0; border-top: 1px solid var(--border); font-size: 0.92rem; }
        .barometer-row-label { flex: 1; }
        .antidote-list { margin: 8px 0 0; padding-left: 20px; }
        .antidote-list li { margin: 6px 0; }

        /* ===== Dossiers vivants (/debats/{id}) ===== */
        .debate-foot { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); }
        .dossier-timeline { margin: 10px 0; }
        .dossier-item { display: grid; grid-template-columns: 52px 1fr; gap: 10px; padding: 8px 0; border-top: 1px solid var(--border); }
        .dossier-date { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.85rem; color: var(--text-muted); padding-top: 2px; }
        .dossier-content { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; }
        .dossier-title { color: var(--text); text-decoration: none; font-weight: 600; }
        .dossier-title:hover { color: var(--accent); text-decoration: underline; }
        .dossier-coverage { display: flex; align-items: flex-end; gap: 3px; margin: 12px 0 4px; }
        .dossier-day { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px; }
        .dossier-bar { width: 100%; min-height: 2px; border-radius: 3px 3px 0 0; background: var(--accent); opacity: 0.85; }
        .dossier-day-label { font-size: 0.62rem; color: var(--text-muted); }
        .dossier-stances { display: flex; flex-direction: column; gap: 6px; margin: 10px 0; }
        .dossier-step { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
        .dossier-step-date { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.82rem; color: var(--text-muted); min-width: 40px; }
        .dossier-media { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin: 10px 0; }
        .dossier-media-card { margin: 0; }
        .dossier-media-card .chips { margin: 6px 0 0; }

        /* ===== Scoops (page Sources) ===== */
        .source-scoop { font-weight: 600; color: var(--stance-nuance); }

        /* ===== Radar des sujets chauds ===== */
        .radar-row { display: grid; grid-template-columns: 180px 1fr 56px 70px; gap: 10px; align-items: center; padding: 6px 0; border-top: 1px solid var(--border); }
        .radar-label { color: var(--text); text-decoration: none; font-weight: 600; font-size: 0.92rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .radar-label:hover { color: var(--accent); text-decoration: underline; }
        .radar-track { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 999px; height: 14px; overflow: hidden; }
        .radar-bar { height: 100%; border-radius: 999px; min-width: 4px; }
        .radar-bar-up { background: var(--anxiety-low); }
        .radar-bar-down { background: var(--anxiety-med); }
        .radar-score { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.85rem; text-align: right; }

        /* ===== Top de la communauté ===== */
        .top-list { list-style: none; margin: 0; padding: 0; counter-reset: top; }
        .top-item { display: flex; gap: 14px; align-items: center; padding: 10px 0; border-top: 1px solid var(--border); }
        .top-rank {
            font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 1.3rem; font-weight: 800;
            color: var(--accent); min-width: 34px; text-align: center; line-height: 1.2;
        }
        .top-body { flex: 1; min-width: 0; }
        .top-title { color: var(--text); text-decoration: none; font-weight: 600; }
        .top-title:hover { color: var(--accent); text-decoration: underline; }
        .top-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 4px; }

        /* Entrées « journal » avec vignette (briefing, journal, il y a un an) */
        .journal-entry-thumb { display: flex; gap: 14px; align-items: flex-start; }
        .journal-entry-thumb .layer-thumb { margin-top: 2px; }
        .journal-entry-main { flex: 1; min-width: 0; }

        /* ===== Bandeau d'erreur Blazor (masqué par défaut) ===== */
        #blazor-error-ui {
            display: none;
            position: fixed; bottom: 0; left: 0; width: 100%;
            background: var(--alert-warning-bg); color: var(--alert-warning-ink);
            padding: 10px 16px; box-shadow: 0 -2px 8px var(--shadow);
            z-index: 1000; font-size: 0.9rem; border-top: 1px solid var(--alert-warning-border);
        }
        #blazor-error-ui .reload { margin-left: 12px; font-weight: 600; }
        #blazor-error-ui .dismiss { margin-left: 10px; cursor: pointer; }

        /* ===== Pagination ===== */
        .pagination { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: center; margin: 22px 0 8px; }
        .pagination button {
            border: 1px solid var(--border-strong); background: var(--surface); color: var(--text);
            border-radius: 8px; padding: 6px 12px; font-size: 0.85rem; cursor: pointer;
        }
        .pagination button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
        .pagination button:disabled { opacity: 0.45; cursor: default; }
        .pagination .page-info { font-size: 0.85rem; color: var(--text); }
        .pagination .page-current { font-weight: 700; }

        /* ===== Pied de page ===== */
        .site-footer { background: var(--nav-bg); color: var(--nav-ink); margin-top: 48px; }
        .footer-inner {
            max-width: 1400px; margin: 0 auto; padding: 28px 24px;
            display: flex; flex-wrap: wrap; gap: 28px; align-items: flex-start; justify-content: space-between;
        }
        .footer-brand { flex: 1 1 300px; max-width: 480px; }
        .footer-brand strong { color: #fff; font-size: 1.05rem; }
        .footer-brand strong span { color: var(--brand-accent); }
        .footer-brand p { margin: 6px 0 0; font-size: 0.85rem; line-height: 1.5; }
        .footer-col { display: flex; flex-direction: column; gap: 8px; }
        .footer-col h3 { margin: 0 0 2px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--nav-ink); }
        .footer-col a { color: var(--nav-ink-hover); text-decoration: none; font-size: 0.9rem; }
        .footer-col a:hover { color: var(--brand-accent); }
        .footer-legal { font-size: 0.82rem; color: var(--nav-ink); }
        .footer-bottom {
            border-top: 1px solid var(--border); text-align: center; padding: 12px 24px;
            font-size: 0.8rem; color: var(--nav-ink);
        }

        /* ===== Page licence ===== */
        .license-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 20px 24px; margin: 16px 0; }
        .license-card h2 { margin-top: 0; }
        .license-card ul { margin: 8px 0; padding-left: 20px; line-height: 1.7; }

        /* ===== Page Sources ===== */
        .source-stats { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
        .source-stat { font-size: 0.92rem; color: var(--text); }
        .source-export { margin-left: auto; display: flex; align-items: center; gap: 8px; }
        .source-export .chip { text-decoration: none; }
        .source-group-title { display: flex; align-items: baseline; gap: 10px; margin: 26px 0 10px; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
        .source-group-title h2 { margin: 0; font-size: 1.15rem; }
        .source-group-title .count { font-size: 0.85rem; color: var(--text-muted); font-weight: 700; }
        .source-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
        .source-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; display: flex; gap: 12px; align-items: flex-start; transition: border-color 0.15s ease; }
        .source-card:hover { border-color: var(--border-strong); }
        .source-favicon { width: 34px; height: 34px; border-radius: 6px; object-fit: contain; background: var(--surface-alt); border: 1px solid var(--border); padding: 3px; flex-shrink: 0; }
        .source-body { min-width: 0; }
        .source-name { font-weight: 700; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .source-meta { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
        .source-links { margin-top: 6px; font-size: 0.85rem; }
        .source-links a { margin-right: 12px; color: var(--accent); text-decoration: none; }
        .source-links a:hover { text-decoration: underline; }
        .source-badge { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 1px 9px; border-radius: 99px; border: 1px solid var(--border-strong); color: var(--text-muted); }
        .source-badge-off { border-color: var(--vote-bad); color: var(--vote-bad); }
        .source-disabled { opacity: 0.6; }
        .source-disabled .source-name { text-decoration: line-through; text-decoration-thickness: 1.5px; }
        [data-theme$="-hc"] .source-card { border-width: 2px; }
        [data-theme$="-hc"] .source-disabled .source-name { text-decoration-thickness: 2px; }

        /* ===== Page Débats ===== */
        .chip-debate { background: #fef3c7; color: #92400e; border: 1px solid #f59e0b; }
        [data-theme="dark"] .chip-debate { background: #452d03; color: #fbbf24; border-color: #b45309; }
        .debate-banner { display: flex; align-items: center; gap: 14px; background: linear-gradient(135deg, #fffbeb, #fef3c7); border: 1px solid #f59e0b; border-radius: 10px; padding: 14px 18px; margin: 16px 0 4px; text-decoration: none; color: var(--text); transition: transform 0.12s ease, box-shadow 0.12s ease; }
        .debate-banner:hover { transform: translateY(-1px); box-shadow: 0 4px 14px var(--shadow); }
        .debate-banner-icon { font-size: 1.6rem; line-height: 1; }
        .debate-banner-text { flex: 1; font-size: 0.95rem; }
        .debate-banner-text strong { color: #92400e; }
        .debate-banner-cta { font-weight: 700; color: #92400e; white-space: nowrap; font-size: 0.9rem; }
        [data-theme="dark"] .debate-banner { background: linear-gradient(135deg, #3b2a06, #452d03); border-color: #b45309; }
        [data-theme="dark"] .debate-banner-text strong, [data-theme="dark"] .debate-banner-cta { color: #fbbf24; }
        [data-theme$="-hc"] .debate-banner { border-width: 2px; }
        .debate-card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 18px 22px; margin: 18px 0; }
        .debate-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 8px; margin-bottom: 14px; }
        .debate-head h2 { margin: 0; font-size: 1.2rem; }
        .debate-head .count { font-size: 0.85rem; color: var(--text-muted); font-weight: 700; }
        .debate-camps { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 14px; }
        .debate-camp { border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; background: var(--surface-alt); }
        .debate-camp h3 { margin: 0 0 8px; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; }
        .debate-camp .count { font-size: 0.8rem; color: var(--text-muted); }
        .debate-camp-pour { border-top: 3px solid #16a34a; }
        .debate-camp-contre { border-top: 3px solid #dc2626; }
        .debate-camp-nuance { border-top: 3px solid #f59e0b; }
        .debate-camp-neutre { border-top: 3px solid #94a3b8; }
        .debate-article { padding: 7px 0; border-bottom: 1px dashed var(--border); }
        .debate-article:last-child { border-bottom: none; }
        .debate-article a { color: var(--text); text-decoration: none; display: block; font-size: 0.92rem; line-height: 1.35; }
        .debate-article a:hover { color: var(--accent); text-decoration: underline; }
        .debate-article .muted { font-size: 0.78rem; }
        [data-theme$="-hc"] .debate-card { border-width: 2px; }

        /* ===== Haut contraste : renforce les éléments ===== */
        [data-theme$="-hc"] .article-card { border-width: 2px; }
        [data-theme$="-hc"] .chip { border: 2px solid currentColor; }
        [data-theme$="-hc"] .tl-pill, [data-theme$="-hc"] .vote-btn, [data-theme$="-hc"] .btn-toggle,
        [data-theme$="-hc"] .af-chip, [data-theme$="-hc"] .pagination button { border-width: 2px; }
        [data-theme$="-hc"] .hint-popup { border: 2px solid currentColor; }

        /* Boutons flottants haut/bas de page (à droite du contenu) */
        .scroll-fabs {
            position: fixed;
            right: 1.25rem;
            bottom: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            z-index: 90;
        }
        .scroll-fab {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 1px solid var(--border-strong);
            background: var(--surface);
            color: var(--text-muted);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transform: translateY(4px);
            transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
        }
        .scroll-fab.visible {
            opacity: 0.92;
            visibility: visible;
            transform: translateY(0);
        }
        .scroll-fab:hover, .scroll-fab:focus-visible {
            background: var(--accent);
            border-color: var(--accent);
            color: var(--accent-ink);
            opacity: 1;
        }
        .scroll-fab:focus-visible {
            outline: 2px solid var(--focus);
            outline-offset: 2px;
        }
        @@media (prefers-reduced-motion: reduce) {
            .scroll-fab { transition: none; }
        }
    </style>
    @if (isRadarBranding)
    {
        @* ============================================================
           Charte graphique « Mode Radar » (specs originales) :
           bleu pétrole #1B4B5A · vert-sarcelle #5FB5A3/#EEF5F3 · ambre #E8A33D
           Inter (corps) · Space Grotesk (titres) · JetBrains Mono (données)
           ============================================================ *@
        <style>
            :root {
                --bg: #f7f8fa;
                --surface: #ffffff;
                --surface-alt: #eef5f3;
                --text: #1a1d23;
                --text-muted: #5b6472;
                --border: #d9e2e6;
                --border-strong: #8fa3ab;
                --accent: #1b4b5a;
                --accent-hover: #143945;
                --accent-ink: #ffffff;
                --focus: #1b4b5a;
                --nav-bg: #1b4b5a;
                --nav-ink: #d5e4e8;
                --nav-ink-hover: #ffffff;
                --brand-accent: #5fb5a3;
                --chip-cat-bg: #fbf0dc;
                --chip-cat-ink: #7a4b00;
                --chip-cat-border: #a16207;
                --chip-tag-bg: transparent;
                --chip-tag-ink: #0f4a3c;
                --chip-tag-border: #2c6e5f;
                --chip-sep: #64748b;
                --stance-pour: #2c6e5f;
                --stance-contre: #c4634a;
                --stance-nuance: #a16207;
                --stance-neutre: #64748b;
                --vote-bad: #c4634a;
                --vote-good: #5fb5a3;
                --vote-ink: #ffffff;
                --success: #3e8e7d;
                --alert-danger-bg: #fae8e4;
                --alert-danger-border: #d9765e;
                --alert-danger-ink: #7a2e1e;
                --alert-warning-bg: #fdf1dc;
                --alert-warning-border: #e8a33d;
                --alert-warning-ink: #7a5312;
                --shadow: rgba(27, 75, 90, 0.10);
                --code-bg: #1b4b5a;
                --code-ink: #e8f4f1;
            }

            [data-theme="dark"] {
                --bg: #0d2027;
                --surface: #132e38;
                --surface-alt: #16343f;
                --text: #f2f7f6;
                --text-muted: #9fb4bb;
                --border: #24424d;
                --border-strong: #3e6371;
                --accent: #5e9eae;
                --accent-hover: #6cb0c2;
                --accent-ink: #0d2027;
                --focus: #6ccbb4;
                --nav-bg: #0a1a20;
                --nav-ink: #a8c3cb;
                --nav-ink-hover: #f2f7f6;
                --brand-accent: #6ccbb4;
                --chip-cat-bg: #3a2e12;
                --chip-cat-ink: #f2c879;
                --chip-cat-border: #e8a33d;
                --chip-tag-bg: transparent;
                --chip-tag-ink: #7fd4c0;
                --chip-tag-border: #6ccbb4;
                --chip-sep: #64748b;
                --stance-pour: #6ccbb4;
                --stance-contre: #d9765e;
                --stance-nuance: #f2b755;
                --stance-neutre: #94a3b8;
                --vote-bad: #d9765e;
                --vote-good: #6ccbb4;
                --vote-ink: #0d2027;
                --success: #6ccbb4;
                --alert-danger-bg: #3a1f1a;
                --alert-danger-border: #d9765e;
                --alert-danger-ink: #f0b9a8;
                --alert-warning-bg: #3a2e12;
                --alert-warning-border: #e8a33d;
                --alert-warning-ink: #f2c879;
                --shadow: rgba(0, 0, 0, 0.35);
                --code-bg: #0a1a20;
                --code-ink: #d5e4e8;
            }

            /* Haut contraste (Radar) : le :root radar (ci-dessus) écrase les blocs HC du thème
               principal (même spécificité, ordre source) → on redéfinit les palettes HC ICI,
               APRÈS :root, pour qu'elles gagnent (sinon « rien ne change » en choisissant un
               thème haut contraste). Base noir/blanc WCAG + accent radar pétrole / jaune. */
            [data-theme="light-hc"] {
                --bg: #ffffff;
                --surface: #ffffff;
                --surface-alt: #ffffff;
                --text: #000000;
                --text-muted: #000000;
                --border: #000000;
                --border-strong: #000000;
                --accent: #00333f;
                --accent-hover: #00222b;
                --accent-ink: #ffffff;
                --focus: #000000;
                --nav-bg: #000000;
                --nav-ink: #ffffff;
                --nav-ink-hover: #ffffff;
                --brand-accent: #ffff00;
                --chip-sep: #000000;
                --vote-bad: #8b0000;
                --vote-good: #006400;
                --vote-ink: #ffffff;
                --success: #006400;
                --alert-danger-bg: #ffffff;
                --alert-danger-border: #000000;
                --alert-danger-ink: #8b0000;
                --alert-warning-bg: #ffffff;
                --alert-warning-border: #000000;
                --alert-warning-ink: #5c3d00;
                --shadow: none;
                --code-bg: #ffffff;
                --code-ink: #000000;
            }
            [data-theme="dark-hc"] {
                --bg: #000000;
                --surface: #000000;
                --surface-alt: #000000;
                --text: #ffffff;
                --text-muted: #ffffff;
                --border: #ffffff;
                --border-strong: #ffffff;
                --accent: #ffd400;
                --accent-hover: #ffe14d;
                --accent-ink: #000000;
                --focus: #ffd400;
                --nav-bg: #000000;
                --nav-ink: #ffffff;
                --nav-ink-hover: #ffffff;
                --brand-accent: #ffff00;
                --chip-sep: #ffffff;
                --vote-bad: #ff6b6b;
                --vote-good: #6bff6b;
                --vote-ink: #000000;
                --success: #6bff6b;
                --alert-danger-bg: #000000;
                --alert-danger-border: #ffffff;
                --alert-danger-ink: #ff6b6b;
                --alert-warning-bg: #000000;
                --alert-warning-border: #ffffff;
                --alert-warning-ink: #ffd400;
                --shadow: none;
                --code-bg: #000000;
                --code-ink: #ffffff;
            }

            /* Haut contraste (Radar) : on garde l'identité ambre (catégorie) / sarcelle (thématique)
               avec des bordures noires et des encres extrêmes — l'icône + le remplissage restent
               les indices redondants en plus de la teinte. */
            [data-theme$="-hc"] {
                --chip-cat-bg: #fdf0dc;
                --chip-cat-ink: #000000;
                --chip-cat-border: #000000;
                --chip-tag-bg: #ffffff;
                --chip-tag-ink: #000000;
                --chip-tag-border: #000000;
            }
            [data-theme="dark-hc"] {
                --chip-cat-bg: #e8a33d;
                --chip-cat-ink: #000000;
                --chip-cat-border: #000000;
                --chip-tag-bg: #000000;
                --chip-tag-ink: #ffffff;
                --chip-tag-border: #ffffff;
            }

            body { font-family: 'Inter', -apple-system, "Segoe UI", Roboto, sans-serif; }
            h1, h2, h3, h4, h5, h6, .card-title, .footer-brand,
            .debate-head h2, .source-name, .source-group-title h2, .license-card h2,
            .status-card strong:first-child { font-family: 'Space Grotesk', 'Inter', sans-serif; letter-spacing: -0.01em; }
            .score, .vote-label, .meta, .source-meta, .debate-head .count,
            .source-group-title .count, .footer-bottom, code { font-family: 'JetBrains Mono', ui-monospace, monospace; }
        </style>
    }
    <script>
        // Apply the theme before the first render (anti-flash): localStorage then system preference
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('vigie24-theme'); } catch (e) {}
            if (!stored) {
                stored = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', stored);

            var font = null;
            try { font = localStorage.getItem('vigie24-font'); } catch (e) {}
            if (!font) font = '100';
            document.documentElement.setAttribute('data-font', font);
        })();
        window.vigie24Theme = {
            get: function () { return document.documentElement.getAttribute('data-theme') || 'light'; },
            set: function (t) {
                document.documentElement.setAttribute('data-theme', t);
                try { localStorage.setItem('vigie24-theme', t); } catch (e) {}
            }
        };
        window.vigie24Font = {
            get: function () { return document.documentElement.getAttribute('data-font') || '100'; },
            set: function (f) {
                document.documentElement.setAttribute('data-font', f);
                try { localStorage.setItem('vigie24-font', f); } catch (e) {}
            }
        };
        // Mode zen : le cookie est lu par le serveur au prerender (filtrage dès le 1er HTML —
        // pas de flash d'articles anxiogènes). Le localStorage reste géré par ZenModeService.
        window.vigie24Zen = {
            set: function (on) {
                var d = new Date();
                d.setTime(on ? d.getTime() + 365 * 24 * 3600 * 1000 : 0);
                document.cookie = 'vigie24_zen=' + (on ? '1' : '0') + '; path=/; expires=' + d.toUTCString() + '; SameSite=Lax';
            }
        };
    </script>

