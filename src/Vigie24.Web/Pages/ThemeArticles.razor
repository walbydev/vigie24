@page "/themes/{Slug}"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext

<PageTitle>@_title - Vigie24</PageTitle>
<HeadContent>
    <meta name="description" content="@_metaDescription" />
    <link rel="canonical" href="https://vigie24.info/themes/@Slug" />
    <meta property="og:title" content="@_title - Vigie24" />
    <meta property="og:description" content="@_metaDescription" />
    <meta property="og:url" content="https://vigie24.info/themes/@Slug" />
    <meta property="og:type" content="website" />
</HeadContent>

@if (_tag == null)
{
    <div class="alert alert-warning" role="alert">Thématique introuvable.</div>
}
else
{
    <div class="breadcrumb">
        <a href="/themes">Thématiques</a>
        <text> › <strong>@_title</strong></text>
    </div>

    <div class="page-head">
        <h1>@_title</h1>
        <span class="muted">@_tagCount article(s)</span>
    </div>

    <ArticleBrowser Filter="@BuildFilter" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Tag? _tag;
    private string _title = "";
    private string _metaDescription = "";
    private int _tagCount;

    protected override async Task OnInitializedAsync()
    {
        // Title computed SYNCHRONOUSLY before any await → visible in the initial HTML (prerender)
        _title = VigieTaxonomy.DisplayName(Slug);
        _tag = await DbContext.Tags.FirstOrDefaultAsync(t => t.Slug == Slug);
        if (_tag == null)
        {
            _title = "Thématique introuvable";
            _metaDescription = "Cette thématique n'existe pas sur Vigie24.";
            return;
        }

        _metaDescription = $"Articles sur le thème {_title} — veille technologique francophone Vigie24.";
        _tagCount = await DbContext.Articles
            .CountAsync(a => a.IsPublished && a.Tags.Any(t => t.TagId == _tag.Id));
    }

    /// <summary>Base filter: published articles of the theme (search/sort/pagination handled by ArticleBrowser)</summary>
    private System.Linq.Expressions.Expression<Func<Article, bool>> BuildFilter() =>
        a => a.IsPublished && a.Tags.Any(t => t.TagId == _tag!.Id);
}
