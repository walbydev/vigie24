@page "/themes/{Slug}"
@using Vigie24.Domain
@using Vigie24.Domain.Models
@using Vigie24.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject Vigie24DbContext DbContext

<PageTitle>@_title - Vigie24</PageTitle>

@if (_tag == null)
{
    <div class="alert alert-warning" role="alert">Thématique introuvable.</div>
}
else
{
    <div class="breadcrumb">
        <a href="/themes">Thématiques</a>
        <text> › <strong>@_title</strong></text>
    </div>

    <div class="page-head">
        <h1>@_title</h1>
        <span class="muted">@_tagCount article(s)</span>
    </div>

    <ArticleBrowser Source="@BuildQuery" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private Tag? _tag;
    private string _title = "";
    private int _tagCount;

    protected override async Task OnInitializedAsync()
    {
        _tag = await DbContext.Tags.FirstOrDefaultAsync(t => t.Slug == Slug);
        if (_tag == null) return;

        _title = VigieTaxonomy.DisplayName(_tag.Slug);
        _tagCount = await DbContext.Articles
            .CountAsync(a => a.IsPublished && a.Tags.Any(t => t.TagId == _tag.Id));
    }

    /// <summary>Requête de base : articles publiés de la thématique (recherche/tri/pagination gérés par ArticleBrowser)</summary>
    private IQueryable<Article> BuildQuery() => DbContext.Articles
        .Include(a => a.Category).ThenInclude(c => c!.ParentCategory)
        .Include(a => a.Authors).ThenInclude(a => a.Author)
        .Include(a => a.Sources).ThenInclude(s => s.Source)
        .Include(a => a.Tags).ThenInclude(t => t.Tag)
        .Where(a => a.IsPublished && a.Tags.Any(t => t.TagId == _tag!.Id));
}
