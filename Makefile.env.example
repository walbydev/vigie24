# =====================================================================
# Makefile.env.example — TEMPLATE (no real values)
# Copy to Makefile.env (gitignored) and fill in your deployment hosts.
#
# STAGING_HOST / PROD_HOST : SSH aliases defined in ~/.ssh/config
#   (e.g. `Host vigie24-staging` → HostName <internal-ip>, User vigie24deploy)
# STAGING_DIR  / PROD_DIR  : deployment directory on the remote host
# =====================================================================
STAGING_HOST=vigie24-staging
STAGING_DIR=vigie24
PROD_HOST=vigie24-prod
PROD_DIR=vigie24
# Release tokens (used by `make release`; keep this file out of version control)
GITEA_TOKEN=
GITHUB_TOKEN=
