# Exemple de configuration du pipeline vigie24 — copier vers un fichier HORS
# du dépôt (ex. /opt/data/vigie24_telegram.env, chmod 600) et le sourcer
# avant d'exécuter run_pipeline.py, ou le passer à systemd via EnvironmentFile.
# Aucun secret de ce fichier ne doit être commité.
VIGIE24_TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# ID numérique du chat Telegram destinataire (DM avec le bot, ex. getUpdates)
VIGIE24_TELEGRAM_CHAT_ID=000000000

# Optionnel : tokens YouTube OAuth (sinon --yt-tokens ou YT_TOKENS_PATH au run)
#YT_TOKENS_PATH=/opt/data/.yt_tokens.json
