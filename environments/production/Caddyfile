# Vigie24 — reverse proxy Caddy (production)
# VIGIE24_DOMAIN (variable .env.production) :
#   - un nom de domaine  -> HTTPS automatique (Let's Encrypt) + redirection 80 -> 443
#   - une IP publique     -> HTTP simple, avec le préfixe http:// obligatoire
#                           (ex: http://203.0.113.10 — sans préfixe, Caddy tenterait HTTPS)
{$VIGIE24_DOMAIN} {
	encode zstd gzip
	reverse_proxy vigie24-web:8080

	# ===== En-têtes de sécurité (défense en profondeur) =====
	# CSP adapté à Blazor Server :
	#   - script-src 'unsafe-inline' : scripts inline du _Host (anti-flash thème + JSON-LD).
	#     Acceptable ici car tout le contenu est échappé par Razor (pas de MarkupString
	#     sur données utilisateur) — à durcir avec des nonces si un jour on les retire.
	#   - style-src 'unsafe-inline' : tout le CSS du _Host est inline.
	#   - font-src fonts.gstatic.com : Google Fonts (thème « Mode Radar »).
	#   - img-src https: : images d'articles hébergées sur les sites sources.
	#   - connect-src ws:/wss: : websocket SignalR de Blazor.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
	}

	# Logs d'accès (analyse de fréquentation) — fichier + rotation
	# Vie privée : Caddy 2.11 masque automatiquement les en-têtes sensibles
	# (Cookie, Set-Cookie, Authorization, Proxy-Authorization → « REDACTED »)
	# dans le format json. Referer, User-Agent et Accept-Language restent
	# consignés pour l'analyse de fréquentation, sans cookies ni identification.
	log {
		output file /data/logs/access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 720h
		}
		format json
		level INFO
	}
}
