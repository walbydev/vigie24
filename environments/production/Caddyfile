# Vigie24 — reverse proxy Caddy (production)
# VIGIE24_DOMAIN (variable .env.production) :
#   - un nom de domaine  -> HTTPS automatique (Let's Encrypt) + redirection 80 -> 443
#   - une IP publique     -> HTTP simple, avec le préfixe http:// obligatoire
#                           (ex: http://203.0.113.10 — sans préfixe, Caddy tenterait HTTPS)
{$VIGIE24_DOMAIN} {
	encode zstd gzip
	reverse_proxy vigie24-web:8080

	# Logs d'accès (analyse de fréquentation) — fichier + rotation
	log {
		output file /data/logs/access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 720h
		}
		format json
		level INFO
	}
}
