{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error",
      "Vigie24": "Warning"
    }
  },
  "AiService": {
    "Temperature": 0.3,
    "MaxTokens": 2048,
    "TimeoutSeconds": 60
  },
  "FeedReader": {
    "PollingIntervalMinutes": 15,
    "MaxConcurrentRequests": 5,
    "MaxDuplicateCheckArticles": 0,
    "ItemDelayMilliseconds": 1500
  },
  "Scoring": {
    "RecencyWeight": 0.4,
    "RelevanceWeight": 0.3,
    "SourceWeight": 0.2,
    "EngagementWeight": 0.1,
    "MaxRecencyHours": 72,
    "MinRelevanceScore": 0.5
  }
}
