# ============================================================
# .env.example — TEMPLATE (placeholder values)
# Copy to .env on the VPS (same folder) and fill in the real secrets.
# .env is IGNORED by git and PROTECTED by the deployment (never overwritten).
# All non-sensitive configuration lives in appsettings.json /
# appsettings.Production.json (mounted as a volume).
# ============================================================

# Public domain or IP of the VPS.
#   - Domain (e.g. vigie24.example.com) -> automatic HTTPS (Let's Encrypt)
#   - Bare IP: http:// prefix REQUIRED (e.g. http://203.0.113.10) -> plain HTTP
VIGIE24_DOMAIN=vigie24.example.com

# AI provider
AI_PROVIDER=infomaniak
INFOMANIAK_API_URL=https://api.infomaniak.com
INFOMANIAK_API_KEY=votre_cle_infomaniak_ici
AI_MODEL=google/gemma-4-31B-it

# Database (created automatically on first start)
DB_NAME=vigie24_prod
DB_USER=postgres_prod
DB_PASSWORD=votre_mdp_postgres_fort
