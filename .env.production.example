# ============================================================
# .env.production.example — TEMPLATE (valeurs factices)
# Copiez vers .env.production sur le VPS et remplissez les vrais secrets.
# .env.production est IGNORÉ par git et PROTÉGÉ par le déploiement (jamais écrasé).
# Toute la config non-sensible vit dans appsettings.json / appsettings.Production.json.
# ============================================================

# Domaine ou IP publique du VPS.
#   - Domaine (ex: vigie24.example.com) -> HTTPS automatique (Let's Encrypt)
#   - IP seule : préfixe http:// OBLIGATOIRE (ex: http://203.0.113.10) -> HTTP simple
VIGIE24_DOMAIN=vigie24.example.com

# Fournisseur IA
AI_PROVIDER=infomaniak
INFOMANIAK_API_URL=https://api.infomaniak.com
INFOMANIAK_API_KEY=votre_cle_infomaniak_ici
AI_MODEL=google/gemma-4-31B-it

# Base de données (créée automatiquement au premier démarrage)
DB_NAME=vigie24_prod
DB_USER=postgres_prod
DB_PASSWORD=votre_mdp_postgres_fort
