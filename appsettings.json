{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Vigie24": "Information"
    }
  },
  "AllowedHosts": "*",
  "AiService": {
    "TimeoutSeconds": 30,
    "Temperature": 0.3,
    "MaxTokens": 4096,
    "Model": "llama-3.1-70b",
    "DeepSeekModel": "deepseek-chat",
    "InfomaniakApiUrl": "https://api.infomaniak.com",
    "DeepSeekApiUrl": "https://api.deepseek.com",
    "Provider": "infomaniak",
    "InputPricePerMillionTokens": 0.20,
    "OutputPricePerMillionTokens": 0.40
  },
  "HealthCheck": {
    "IngestionOkMinutes": 30,
    "IngestionDegradedMinutes": 120,
    "ProviderPingMinutes": 10
  },
  "FeedReader": {
    "PollingIntervalMinutes": 15,
    "MaxConcurrentRequests": 5,
    "UserAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36",
    "RequestTimeoutSeconds": 30
  },
  "Scoring": {
    "RecencyWeight": 0.4,
    "RelevanceWeight": 0.3,
    "SourceWeight": 0.2,
    "EngagementWeight": 0.1,
    "MaxRecencyHours": 72,
    "MinRelevanceScore": 0.5
  },
  "Database": {
    "MigrateOnStartup": true,
    "CommandTimeoutSeconds": 60
  }
}
