{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information",
      "Vigie24": "Debug"
    }
  },
  "AiService": {
    "Temperature": 0.7,
    "MaxTokens": 2048
  },
  "FeedReader": {
    "PollingIntervalMinutes": 5,
    "MaxConcurrentRequests": 3
  },
  "Scoring": {
    "RecencyWeight": 0.5,
    "RelevanceWeight": 0.3,
    "SourceWeight": 0.15,
    "EngagementWeight": 0.05
  }
}
